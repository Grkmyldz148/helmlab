---
import BaseLayout from "../layouts/BaseLayout.astro";
import StressChart from "../components/react/StressChart";
import OverfitPanel from "../components/react/OverfitPanel";
import CategoryCards from "../components/react/CategoryCards";
import BenchmarkExplorer from "../components/react/BenchmarkExplorer";
import {
  independentSummary,
  independentTotals,
  hungBernsPerHue,
  hungBernsSummary,
  ebnerFairchild,
  ebnerFairchildSummary,
  pointerGamut,
  pointerGamutSummary,
} from "../data/independent";
import { headlineScore } from "../data/genspace-results";
import {
  claims,
  winShort,
  totalMetrics,
  independentStr,
  ciede2000ImprovementPct,
  oklabDeutanAdvantagePct,
  oklabNearAchromAdvantagePct,
} from "../data/claims";
---

<BaseLayout
  title="Benchmark — Helmlab"
  description={`${totalMetrics()} metrics, 13 categories, complete transparency. GenSpace beats OKLab ${winShort()}. MetricSpace achieves STRESS ${claims.stress.metricSpace.combvd}, beating CIEDE2000 by ${ciede2000ImprovementPct()}%.`}
>
  <!-- ═══════════════════════════ Hero ═══════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#f97316]/[0.03] to-transparent pointer-events-none"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Benchmark</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mt-4 mb-6">
        90 Metrics, Complete<br />
        <span class="bg-gradient-to-r from-[#f97316] to-[#fb923c] bg-clip-text text-transparent">Transparency</span>
      </h1>
      <p class="for-designer text-lg text-[#a1a1aa] max-w-2xl mx-auto mb-8">
        Every claim on this site is backed by reproducible benchmarks.
        We show our wins, our losses, and even our overfitting analysis.
      </p>
      <p class="for-dev text-lg text-[#a1a1aa] max-w-2xl mx-auto mb-8">
        ColorBench: deterministic, float64, 13 categories. All data, scripts, and checkpoints are open source.
        No cherry-picking. Full train/test split analysis included.
      </p>

      <!-- Score pills -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <div class="inline-flex items-center gap-2 rounded-full bg-[#34d399]/10 border border-[#34d399]/20 px-4 py-2">
          <span class="text-[#34d399] font-bold text-lg">{headlineScore.genspaceWins}</span>
          <span class="text-[#a1a1aa] text-sm">GenSpace wins</span>
        </div>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/[0.04] border border-white/[0.08] px-4 py-2">
          <span class="text-[#52525b] font-bold text-lg">{headlineScore.ties}</span>
          <span class="text-[#52525b] text-sm">ties</span>
        </div>
        <div class="inline-flex items-center gap-2 rounded-full bg-[#f87171]/10 border border-[#f87171]/20 px-4 py-2">
          <span class="text-[#f87171] font-bold text-lg">{headlineScore.oklabWins}</span>
          <span class="text-[#a1a1aa] text-sm">OKLab wins</span>
        </div>
      </div>

      <p class="text-xs text-[#3f3f46] mt-4">
        {headlineScore.internalMetrics} internal + {headlineScore.independentMetrics} independent validation = {headlineScore.totalMetrics} total metrics
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════ STRESS Scores ═══════════════════════════ -->
  <section class="py-16 md:py-24" id="stress">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">MetricSpace</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Color Difference Accuracy
        </h2>
        <p class="for-designer text-[#a1a1aa] max-w-2xl">
          MetricSpace predicts human color perception more accurately than any existing standard,
          including the industry-standard CIEDE2000 formula.
        </p>
        <p class="for-dev text-[#a1a1aa] max-w-2xl">
          STRESS (CIE 217:2016) evaluated on COMBVD ({claims.datasets.combvdPairs.toLocaleString()} pairs from 6 sub-datasets)
          and the held-out MacAdam 1974 set ({claims.datasets.macadamPairs} pairs). Lower is better.
          Our own human-feedback set is reported separately below — rank-order only.
        </p>
      </div>

      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <StressChart client:only="react" />
      </div>

      <!-- Our own human-feedback set — rank-order only (audit 2026-06-10) -->
      <div class="mt-6 rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <h3 class="text-sm font-medium text-[#fafafa] mb-1">
          Our Own Human-Feedback Set
          <span class="ml-2 text-[10px] px-2 py-0.5 rounded-full border border-[#f97316]/30 text-[#f97316] bg-[#f97316]/5 uppercase tracking-wider">rank-order only</span>
        </h3>
        <p class="text-xs text-[#52525b] mb-4 leading-relaxed">
          {claims.humanFbRank.judgements.toLocaleString()} judgements by {claims.humanFbRank.observers} observers over
          {claims.humanFbRank.pairs} color pairs, collected on helmlab.space. We audited this set and do NOT publish
          STRESS on it: ratings are 5-level categorical, which breaks interval-scale metrics — any STRESS number
          from it (ours included) is a scale artifact. Rank order is the honest statistic. Two more caveats:
          pairs were sampled from helmlab's own hue zones (not independent), and with 47 pairs the
          MetricSpace–CIEDE2000 gap is only marginally significant
          (Δρ 95% CI [+{claims.humanFbRank.deltaRhoCI95[0]}, +{claims.humanFbRank.deltaRhoCI95[1]}], paired bootstrap).
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <div class="rounded-lg border border-white/[0.06] bg-white/[0.02] px-3 py-2">
            <div class="text-xs text-[#52525b] mb-1">MetricSpace</div>
            <div class="text-sm font-mono font-medium text-[#34d399]">ρ = {claims.humanFbRank.spearman.metricSpace}</div>
          </div>
          <div class="rounded-lg border border-white/[0.06] bg-white/[0.02] px-3 py-2">
            <div class="text-xs text-[#52525b] mb-1">CIEDE2000</div>
            <div class="text-sm font-mono text-[#a1a1aa]">ρ = {claims.humanFbRank.spearman.ciede2000}</div>
          </div>
          <div class="rounded-lg border border-white/[0.06] bg-white/[0.02] px-3 py-2">
            <div class="text-xs text-[#52525b] mb-1">CIE Lab ΔE76</div>
            <div class="text-sm font-mono text-[#a1a1aa]">ρ = {claims.humanFbRank.spearman.cielab}</div>
          </div>
          <div class="rounded-lg border border-white/[0.06] bg-white/[0.02] px-3 py-2">
            <div class="text-xs text-[#52525b] mb-1">OKLab</div>
            <div class="text-sm font-mono text-[#a1a1aa]">ρ = {claims.humanFbRank.spearman.oklab}</div>
          </div>
        </div>
      </div>

      <!-- Additional held-out datasets (color-perception-datasets pool) -->
      <div class="mt-6 rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <h3 class="text-sm font-medium text-[#fafafa] mb-1">More Held-Out Datasets</h3>
        <p class="text-xs text-[#52525b] mb-4 leading-relaxed">
          STRESS on independent psychophysical sets MetricSpace was never trained on
          (same protocol: Bradford CAT to D65, CAM16-UCS via colour-science with a
          gray-ramp sanity check). One of these we lose — published anyway.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-[#52525b]">
                <th class="text-left font-normal py-1 pr-2">Dataset</th>
                <th class="text-right font-normal py-1 px-2">MetricSpace</th>
                <th class="text-right font-normal py-1 px-2">CIEDE2000</th>
                <th class="text-right font-normal py-1 px-2">CAM16-UCS</th>
                <th class="text-right font-normal py-1 px-2">CIE Lab</th>
                <th class="text-right font-normal py-1 pl-2">OKLab</th>
              </tr>
            </thead>
            <tbody class="font-mono">
              {claims.heldOutStress.map((r) => (
                <tr class="border-t border-white/[0.04]">
                  <td class="py-1.5 pr-2 font-sans text-[#a1a1aa]">{r.name} <span class="text-[#3f3f46]">n={r.n}</span><br /><span class="text-[10px] text-[#3f3f46]">{r.note}</span></td>
                  <td class={`text-right py-1.5 px-2 ${r.winner === 'metricSpace' ? 'text-[#34d399] font-medium' : 'text-[#a1a1aa]'}`}>{r.metricSpace.toFixed(2)}</td>
                  <td class={`text-right py-1.5 px-2 ${r.winner === 'ciede2000' ? 'text-[#60a5fa] font-medium' : 'text-[#52525b]'}`}>{r.ciede2000.toFixed(2)}</td>
                  <td class={`text-right py-1.5 px-2 ${r.winner === 'cam16ucs' ? 'text-[#60a5fa] font-medium' : 'text-[#52525b]'}`}>{r.cam16ucs.toFixed(2)}</td>
                  <td class={`text-right py-1.5 px-2 ${r.winner === 'cielab' ? 'text-[#60a5fa] font-medium' : 'text-[#52525b]'}`}>{r.cielab.toFixed(2)}</td>
                  <td class={`text-right py-1.5 pl-2 ${r.winner === 'oklab' ? 'text-[#60a5fa] font-medium' : 'text-[#52525b]'}`}>{r.oklab.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ GenSpace Overview ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="genspace">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">GenSpace</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Generation Benchmark: {winShort()}
        </h2>
        <p class="for-designer text-[#a1a1aa] max-w-2xl">
          GenSpace is purpose-built for creating colors: gradients, palettes, gamut mapping.
          Head-to-head against OKLab (the current CSS standard), it wins {claims.record.genspace} out of {totalMetrics()} metrics.
        </p>
        <p class="for-dev text-[#a1a1aa] max-w-2xl">
          {claims.internalMetrics} internal metrics (deterministic, float64) + {claims.independentMetrics} independent validation metrics.
          Opponent: OKLab with standard Euclidean deltaE. Same test harness, same precision.
        </p>
      </div>

      <!-- Summary stat boxes -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-4 text-center">
          <div class="text-3xl font-bold text-[#34d399]">{claims.record.genspace}</div>
          <div class="text-xs text-[#52525b] mt-1">GenSpace wins</div>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-4 text-center">
          <div class="text-3xl font-bold text-[#f87171]">{claims.record.oklab}</div>
          <div class="text-xs text-[#52525b] mt-1">OKLab wins</div>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-4 text-center">
          <div class="text-3xl font-bold text-[#52525b]">{claims.record.ties}</div>
          <div class="text-xs text-[#52525b] mt-1">Ties</div>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-4 text-center">
          <div class="text-3xl font-bold text-[#fafafa]">13</div>
          <div class="text-xs text-[#52525b] mt-1">Categories</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Category Breakdown ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="categories">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">By Category</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Category Breakdown
        </h2>
        <p class="text-[#a1a1aa] max-w-2xl">
          Click any card to expand and see every individual metric in that category.
        </p>
      </div>

      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <CategoryCards client:visible />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Full Explorer ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="explorer">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Full Data</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Metric Explorer
        </h2>
        <p class="for-designer text-[#a1a1aa] max-w-2xl">
          Search and filter all {claims.record.total} benchmark metrics. Every number is reproducible.
        </p>
        <p class="for-dev text-[#a1a1aa] max-w-2xl">
          Sortable, filterable table of all metrics. Values are from the canonical
          ColorBench run: GenSpace v0.11.1 vs OKLab, both at float64 precision.
        </p>
      </div>

      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-4 sm:p-6 md:p-8">
        <BenchmarkExplorer client:visible />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Independent Validation ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="independent">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Independent Validation</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Tested on Data We Never Trained On
        </h2>
        <p class="for-designer text-[#a1a1aa] max-w-2xl">
          Three independent datasets from published color science research (1980-1998).
          GenSpace wins {independentStr()} against OKLab on data it never saw.
        </p>
        <p class="for-dev text-[#a1a1aa] max-w-2xl">
          Hung & Berns 1995 (hue linearity, 168 samples), Ebner & Fairchild 1998 (constant-hue surfaces, 321 samples),
          Pointer 1980 (real surface color gamut, 576 boundary points). None used in optimization.
        </p>
      </div>

      <!-- Summary cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-medium text-[#fafafa]">
              Hung & Berns
              <span class="text-[#3f3f46] font-normal ml-1">1995</span>
            </h3>
            <span class="text-xs text-[#52525b]">{hungBernsSummary.samples} samples</span>
          </div>
          <p class="for-designer text-xs text-[#52525b] mb-3">
            Do straight lines in the color space match straight lines in human hue perception?
          </p>
          <p class="for-dev text-xs text-[#52525b] mb-3">
            Hue linearity: angular deviation from constant-hue lines. 12 hues, 13 targets each, 9 observers.
          </p>
          <div class="space-y-1.5">
            {hungBernsPerHue.map((h) => (
              <div class="flex items-center justify-between text-xs" key={h.hue}>
                <span class="text-[#a1a1aa]">{h.hue}</span>
                <div class="flex items-center gap-2">
                  <span class={`font-mono ${h.winner === "oklab" ? "text-[#60a5fa] font-medium" : "text-[#52525b]"}`}>
                    {h.oklab.toFixed(2)}
                  </span>
                  <span class="text-[#3f3f46]">vs</span>
                  <span class={`font-mono ${h.winner === "genspace" ? "text-[#34d399] font-medium" : h.winner === "tie" ? "text-[#a1a1aa]" : "text-[#52525b]"}`}>
                    {h.genspace.toFixed(2)}
                  </span>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-3 pt-3 border-t border-white/[0.04] flex justify-between text-xs">
            <span class="text-[#a1a1aa]">Score</span>
            <span>
              <span class="text-[#34d399] font-medium">{hungBernsSummary.genspaceWins}W</span>
              <span class="text-[#52525b] mx-1">{hungBernsSummary.ties}T</span>
              <span class="text-[#f87171]">{hungBernsSummary.oklabWins}L</span>
            </span>
          </div>
        </div>

        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-medium text-[#fafafa]">
              Ebner & Fairchild
              <span class="text-[#3f3f46] font-normal ml-1">1998</span>
            </h3>
            <span class="text-xs text-[#52525b]">{ebnerFairchildSummary.samples} samples</span>
          </div>
          <p class="for-designer text-xs text-[#52525b] mb-3">
            When you change lightness and chroma but keep the hue name the same, does the color space agree?
          </p>
          <p class="for-dev text-xs text-[#52525b] mb-3">
            Constant perceived-hue surface deviation. 15 hues. Mean and max angular deviation from ideal.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-xs mt-2">
              <thead>
                <tr class="text-[#3f3f46]">
                  <th class="text-left py-1 font-medium">Space</th>
                  <th class="text-right py-1 font-medium">Mean</th>
                  <th class="text-right py-1 font-medium">Max</th>
                </tr>
              </thead>
              <tbody>
                {ebnerFairchild.map((row) => (
                  <tr key={row.space} class="border-t border-white/[0.04]">
                    <td class={`py-1.5 ${row.space === "GenSpace" ? "text-[#34d399] font-medium" : "text-[#a1a1aa]"}`}>
                      {row.space}
                    </td>
                    <td class={`py-1.5 text-right font-mono ${row.space === "GenSpace" ? "text-[#34d399]" : "text-[#52525b]"}`}>
                      {row.meanAngularDeviation.toFixed(2)}
                    </td>
                    <td class={`py-1.5 text-right font-mono ${row.space === "OKLab" ? "text-[#60a5fa]" : "text-[#52525b]"}`}>
                      {row.maxAngularDeviation.toFixed(1)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mt-3 pt-3 border-t border-white/[0.04] text-xs text-[#52525b]">
            GenSpace wins mean deviation. OKLab wins max deviation.
          </div>
        </div>

        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-medium text-[#fafafa]">
              Pointer's Gamut
              <span class="text-[#3f3f46] font-normal ml-1">1980</span>
            </h3>
            <span class="text-xs text-[#52525b]">{pointerGamutSummary.boundaryPoints} pts</span>
          </div>
          <p class="for-designer text-xs text-[#52525b] mb-3">
            How uniformly does each space represent real-world surface colors?
          </p>
          <p class="for-dev text-xs text-[#52525b] mb-3">
            Real surface color boundary (16 L levels, 36 hue angles). Chroma CV, boundary smoothness, hue uniformity.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-xs mt-2">
              <thead>
                <tr class="text-[#3f3f46]">
                  <th class="text-left py-1 font-medium">Space</th>
                  <th class="text-right py-1 font-medium">C* CV</th>
                  <th class="text-right py-1 font-medium">Smooth</th>
                  <th class="text-right py-1 font-medium">Hue CV</th>
                </tr>
              </thead>
              <tbody>
                {pointerGamut.map((row) => (
                  <tr key={row.space} class="border-t border-white/[0.04]">
                    <td class={`py-1.5 ${row.space === "GenSpace" ? "text-[#34d399] font-medium" : "text-[#a1a1aa]"}`}>
                      {row.space}
                    </td>
                    <td class={`py-1.5 text-right font-mono ${row.space === "GenSpace" ? "text-[#34d399]" : "text-[#52525b]"}`}>
                      {row.chromaCV.toFixed(3)}
                    </td>
                    <td class={`py-1.5 text-right font-mono ${row.space === "GenSpace" ? "text-[#34d399]" : "text-[#52525b]"}`}>
                      {row.boundarySmoothness.toFixed(3)}
                    </td>
                    <td class={`py-1.5 text-right font-mono ${row.space === "CIE Lab" ? "text-[#60a5fa]" : "text-[#52525b]"}`}>
                      {row.hueUniformityCV.toFixed(3)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mt-3 pt-3 border-t border-white/[0.04] text-xs text-[#52525b]">
            {pointerGamutSummary.note}
          </div>
        </div>
      </div>

      <!-- Independent totals -->
      <div class="rounded-xl border border-[#34d399]/20 bg-[#34d399]/[0.04] p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-medium text-[#fafafa] mb-1">Independent Validation Total</h4>
          <p class="text-xs text-[#a1a1aa]">
            Across 3 published datasets (1980-1998), none used in training
          </p>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-[#34d399] font-bold text-lg">{independentTotals.genspaceWins}</span>
          <span class="text-[#52525b]">-</span>
          <span class="text-[#f87171] font-bold text-lg">{independentTotals.oklabWins}</span>
          <span class="text-xs text-[#52525b]">
            ({independentTotals.totalMetrics} metrics)
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Overfitting Analysis ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="overfitting">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Honesty Check</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          Overfitting Analysis
        </h2>
        <p class="for-designer text-[#a1a1aa] max-w-2xl">
          We optimized MetricSpace on color difference data. Could it have just memorized the answers?
          We tested this honestly and show you the results.
        </p>
        <p class="for-dev text-[#a1a1aa] max-w-2xl">
          80/20 stratified split (seed=42), multiple DOF configurations.
          Train-test gap exists (+1.8) but held-out test still beats all competitors.
        </p>
      </div>

      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <OverfitPanel client:visible />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ MetricSpace Use Cases ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="metric-usecases">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#60a5fa] font-medium">MetricSpace</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-3 mb-3">When to Use MetricSpace</h2>
        <p class="text-[#a1a1aa] max-w-2xl text-sm">
          MetricSpace is purpose-built for color difference prediction — not generation. Use it when you need to measure, not create.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-1">Quality Control</h3>
          <p class="text-xs text-[#a1a1aa]">Print, display, textile color matching. {ciede2000ImprovementPct()}% lower STRESS than CIEDE2000 on COMBVD.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-1">Color Matching Tolerance</h3>
          <p class="text-xs text-[#a1a1aa]">Pair-dependent SL/SC weighting adapts to the specific lightness and chroma of each color pair.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-1">A/B Testing</h3>
          <p class="text-xs text-[#a1a1aa]">Ranks real user judgments better than CIEDE2000 (Spearman {claims.humanFbRank.spearman.metricSpace} vs {claims.humanFbRank.spearman.ciede2000}) on our own {claims.humanFbRank.pairs}-pair human-feedback set — rank-order only, see note below.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-1">Accessibility Checking</h3>
          <p class="text-xs text-[#a1a1aa]">Euclidean deltaE that's actually perceptually calibrated. OKLab STRESS = {claims.stress.oklab.combvd} — not designed for distance prediction.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-1">Research</h3>
          <p class="text-xs text-[#a1a1aa]">Transparent pipeline, fully invertible, open source. All parameters, datasets, and optimization scripts published.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Are We the Best? ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="verdict">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Verdict</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">Are We the Best?</h2>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl border border-[#34d399]/20 bg-[#34d399]/[0.04] p-6">
          <h3 class="text-lg font-bold text-[#34d399] mb-2">Color difference measurement: Yes.</h3>
          <p class="text-sm text-[#a1a1aa]">
            MetricSpace v21 achieves the lowest published STRESS on COMBVD,
            is within 0.8 of the best (CAM16-UCS) on the held-out {claims.datasets.macadamPairs}-pair MacAdam set,
            and ranks our own human-feedback set better than CIEDE2000 (Spearman {claims.humanFbRank.spearman.metricSpace} vs {claims.humanFbRank.spearman.ciede2000}).
            No other metric matches human perception this accurately across this range of datasets.
            <span class="text-[#52525b]">Caveat: cross-validated estimate is ~{claims.overfit.crossValidated} (not the published {claims.stress.metricSpace.combvd}), and CIEDE2000 wins on 3 of 6 COMBVD sub-datasets.</span>
          </p>
        </div>
        <div class="rounded-2xl border border-[#34d399]/20 bg-[#34d399]/[0.04] p-6">
          <h3 class="text-lg font-bold text-[#34d399] mb-2">Generation tasks: Best-rounded, not best at everything.</h3>
          <p class="text-sm text-[#a1a1aa]">
            GenSpace wins {winShort()} vs OKLab across {totalMetrics()} metrics, including {independentStr()} on independent 3rd-party datasets OKLab was optimized on.
            However: OKLab is better for near-achromatic gradients ({oklabNearAchromAdvantagePct()}%), CVD deutan palettes ({oklabDeutanAdvantagePct()}%), and native CSS oklch().
            CIE Lab's hue angles remain the established industry reference for hue naming.
          </p>
        </div>
        <div class="rounded-2xl border border-[#f97316]/20 bg-[#f97316]/[0.04] p-6">
          <h3 class="text-lg font-bold text-[#f97316] mb-2">Overall: First to do both.</h3>
          <p class="text-sm text-[#a1a1aa]">
            Helmlab is the first color space library to achieve state-of-the-art in both perceptual color difference measurement
            and visual generation quality simultaneously. No other space does both.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ Methodology ═══════════════════════════ -->
  <section class="py-16 md:py-24 border-t border-white/[0.04]" id="methodology">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-10">
        <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Methodology</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-3">
          How We Test
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-2">Deterministic</h3>
          <p class="text-xs text-[#a1a1aa]">
            Every metric is computed at float64 precision with fixed seeds.
            Run the same code, get the same numbers. No stochastic variation.
          </p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-2">Head-to-head</h3>
          <p class="text-xs text-[#a1a1aa]">
            Same test harness, same input colors, same precision for both spaces.
            Winner is determined by the metric's natural direction (lower or higher is better).
          </p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-2">No Cherry-picking</h3>
          <p class="text-xs text-[#a1a1aa]">
            All metrics are reported, including our {claims.record.oklab} losses.
            We do not add or remove metrics based on whether we win them.
          </p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-[#0c0c0f] p-5">
          <h3 class="text-sm font-medium text-[#fafafa] mb-2">Open Source</h3>
          <p class="text-xs text-[#a1a1aa]">
            ColorBench source code, all data files, and checkpoint parameters
            are publicly available on GitHub for independent verification.
          </p>
        </div>
      </div>

      <!-- What We Did NOT Test -->
      <div class="mt-8 rounded-xl border border-[#f87171]/20 bg-[#f87171]/[0.04] p-5">
        <h3 class="text-sm font-medium text-[#f87171] mb-3">What We Did NOT Test</h3>
        <ul class="space-y-1.5 text-xs text-[#a1a1aa]">
          <li><strong class="text-[#fafafa]">HDR color differences</strong> — no HDR psychophysical dataset available</li>
          <li><strong class="text-[#fafafa]">Cross-surround conditions</strong> — all data is standard viewing conditions</li>
          <li><strong class="text-[#fafafa]">Display-specific gamuts</strong> — only standard sRGB / Display P3 / Rec.2020 primaries</li>
          <li><strong class="text-[#fafafa]">Computational performance</strong> — not formally benchmarked (JS microbenchmark: GenSpace ≈2.5–2.7× OKLab per color)</li>
          <li><strong class="text-[#fafafa]">Perceptual ranking with human observers</strong> — GenSpace metrics test geometric/mathematical properties, not direct human preference</li>
        </ul>
      </div>


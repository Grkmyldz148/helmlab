<span class="text-[#52525b]"># --color-100: #dbeafe;</span>
<span class="text-[#52525b]"># ...</span>

<span class="text-[#52525b]"># Export as Tailwind config</span>
tw = <span class="text-[#34d399]">export_tokens</span>(scale, format=<span class="text-[#fb923c]">"tailwind"</span>)</code></pre>
            </div>

            <div class="docs-js">
              <pre class="rounded-lg bg-[#111115] p-4 overflow-x-auto"><code class="font-mono text-sm"><span class="text-[#c084fc]">import</span> {"{"} exportTokens {"}"} <span class="text-[#c084fc]">from</span> <span class="text-[#fb923c]">'helmlab'</span>;


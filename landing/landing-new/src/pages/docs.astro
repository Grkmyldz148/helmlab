    });

    // Highlight current section in sidebar (scroll-based, not IntersectionObserver)
    var sections = Array.from(document.querySelectorAll('section[id]'));
    var sidebarLinks = document.querySelectorAll('aside nav a[href^="#"]');
    var currentActive = null;

    function setActive(id) {
      if (currentActive === id) return;
      currentActive = id;
      sidebarLinks.forEach(function(link) {
        link.style.color = '';
        link.style.backgroundColor = '';
        link.style.fontWeight = '';
        link.style.borderRadius = '';
      });
      // Apply to ALL matching links (mobile + desktop sidebars)
      var activeLinks = document.querySelectorAll('aside nav a[href="#' + id + '"]');
      activeLinks.forEach(function(activeLink) {
        activeLink.style.color = '#fafafa';
        activeLink.style.backgroundColor = 'rgba(255,255,255,0.06)';
        activeLink.style.fontWeight = '500';
        activeLink.style.borderRadius = '6px';
      });
    }

    function updateActiveOnScroll() {
      var offset = 100;
      var current = sections[0];
      var positions = [];
      for (var i = 0; i < sections.length; i++) {
        var rect = sections[i].getBoundingClientRect();
        positions.push({ id: sections[i].id, top: Math.round(rect.top) });
        if (rect.top <= offset) {
          current = sections[i];
        } else {
          break;
        }
      }
      if (current) setActive(current.id);
    }

    // Initial state
    if (window.location.hash) {
      setActive(window.location.hash.slice(1));
      setTimeout(function() {
        updateActiveOnScroll();
      }, 200);
    } else {
      updateActiveOnScroll();
    }

    // Update on scroll (throttled with requestAnimationFrame)
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          updateActiveOnScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Also update when clicking sidebar links
    sidebarLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        var href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          setActive(href.slice(1));
          setTimeout(updateActiveOnScroll, 500);
        }
      });
    });
  </script>

  <!-- Client-side docs search (no deps): indexes section headings + method names -->
  <script is:inline>
    (function () {
      const input = document.getElementById('docs-search');
      const out = document.getElementById('docs-search-results');
      if (!input || !out) return;
      const index = [];
      document.querySelectorAll('section[id]').forEach((sec) => {
        const sectionLabel = (sec.querySelector('h2')?.textContent || sec.id).trim();
        sec.querySelectorAll('h2, h3').forEach((h) => {
          if (!h.id) {
            h.id = (sec.id + '-' + (h.textContent || '').trim().toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')).replace(/-+$/, '');
          }
          const title = (h.textContent || '').trim();
          if (title) index.push({ title, section: sectionLabel, id: h.id });
        });
      });
      function render(items) {
        if (!items.length) {
          out.innerHTML = '<div class="px-3 py-2 text-sm text-[#52525b]">No matches</div>';
        } else {
          out.innerHTML = items.slice(0, 12).map((it) =>
            '<a href="#' + it.id + '" class="block rounded px-3 py-1.5 text-sm text-[#a1a1aa] hover:bg-white/[0.06] hover:text-white">' +
            it.title + '<span class="block text-[10px] text-[#52525b]">' + it.section + '</span></a>'
          ).join('');
        }
        out.classList.remove('hidden');
      }
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { out.classList.add('hidden'); return; }
        render(index.filter((it) =>
          it.title.toLowerCase().includes(q) || it.section.toLowerCase().includes(q)));
      });
      out.addEventListener('click', () => { out.classList.add('hidden'); input.value = ''; });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { input.value = ''; out.classList.add('hidden'); input.blur(); }
        if (e.key === 'Enter') { const a = out.querySelector('a'); if (a) a.click(); }
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.focus(); }
      });
      document.addEventListener('click', (e) => {
        if (e.target !== input && !out.contains(e.target)) out.classList.add('hidden');
      });
    })();
  </script>
</BaseLayout>

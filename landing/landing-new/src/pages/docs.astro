      console.log('[docs] setActive:', id, '(was:', currentActive + ')');
      currentActive = id;
      sidebarLinks.forEach(function(link) {
        link.style.color = '';
        link.style.backgroundColor = '';
        link.style.fontWeight = '';
        link.style.borderRadius = '';
      });
      // Apply to ALL matching links (mobile + desktop sidebars)
      var activeLinks = document.querySelectorAll('aside nav a[href="#' + id + '"]');
      console.log('[docs] activeLinks found:', activeLinks.length, 'for id:', id);
      activeLinks.forEach(function(activeLink) {
        activeLink.style.color = '#fafafa';
        activeLink.style.backgroundColor = 'rgba(255,255,255,0.06)';
        activeLink.style.fontWeight = '500';
        activeLink.style.borderRadius = '6px';
      });
    }

    function updateActiveOnScroll() {
      var offset = 100;
      var current = sections[0];
      var positions = [];
      for (var i = 0; i < sections.length; i++) {
        var rect = sections[i].getBoundingClientRect();
        positions.push({ id: sections[i].id, top: Math.round(rect.top) });
        if (rect.top <= offset) {
          current = sections[i];
        } else {
          break;
        }
      }
      console.log('[docs] scroll check, scrollY:', Math.round(window.scrollY), 'positions:', positions, 'picked:', current && current.id);
      if (current) setActive(current.id);
    }

    // Initial state
    console.log('[docs] initial hash:', window.location.hash);
    if (window.location.hash) {
      setActive(window.location.hash.slice(1));
      setTimeout(function() {
        console.log('[docs] post-hash settle scroll check');
        updateActiveOnScroll();
      }, 200);
    } else {
      updateActiveOnScroll();
    }

    // Update on scroll (throttled with requestAnimationFrame)
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          updateActiveOnScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Also update when clicking sidebar links
    sidebarLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        var href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          setActive(href.slice(1));
          setTimeout(updateActiveOnScroll, 500);
        }
      });
    });
  </script>
</BaseLayout>

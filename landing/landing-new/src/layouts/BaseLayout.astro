---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Helmlab — Perceptual Color Space",
  description = "A perceptually uniform color space engineered for designers and developers. Beats CIEDE2000 on color difference, gradient smoothness, and gamut mapping.",
  ogImage = "/og-card.png",
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://helmlab.space");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(ogImage, siteURL).href;
---

<!doctype html>
<html lang="en" class="audience-developer">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Helmlab" />
    <meta name="application-name" content="Helmlab" />
    <meta name="theme-color" content="#09090b" />
    <link rel="mask-icon" href="/favicon.svg" color="#f97316" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="canonical" href={canonicalURL.href} />
    <meta name="generator" content={Astro.generator} />

    <!-- JSON-LD Structured Data: SoftwareApplication -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Helmlab",
      "description": description,
      "url": "https://helmlab.space",
      "image": "https://helmlab.space/og-card.png",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "softwareVersion": "0.11.8",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "license": "https://opensource.org/licenses/MIT",
      "author": {
        "@type": "Person",
        "name": "Grkmyldz148",
        "url": "https://github.com/Grkmyldz148"
      },
      "codeRepository": "https://github.com/Grkmyldz148/helmlab",
      "programmingLanguage": ["Python", "JavaScript", "TypeScript"],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": "1"
      }
    })} />

    <!-- Render-blocking: set audience class before paint to prevent flash -->
    <script is:inline>
      (function() {
        var s = localStorage.getItem("helmlab-audience");
        if (s === "designer" || s === "developer") {
          document.documentElement.className = document.documentElement.className
            .replace("audience-developer", "").replace("audience-designer", "").trim()
            + " audience-" + s;
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#09090b] text-[#fafafa] antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

  </body>
</html>

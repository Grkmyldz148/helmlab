---
// CodeExamples — Python/JS tab component with minimal JS for tab switching
import { claims } from '../data/claims';
---

<section class="py-16 md:py-24" id="quickstart">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Quick Start</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">Works where you work</h2>
      <p class="text-[#a1a1aa] max-w-2xl mx-auto">
        Python and JavaScript with identical APIs. TypeScript types included. Zero dependencies in JS.
      </p>
    </div>

    <div class="code-tabs-wrapper max-w-3xl mx-auto">
      <!-- Tab buttons -->
      <div class="flex gap-1 mb-0 rounded-t-2xl border border-b-0 border-white/[0.06] bg-[#0c0c0f] p-1.5">
        <button
          type="button"
          class="code-tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors bg-white/[0.06] text-[#fafafa]"
          data-tab="python"
        >
          Python
        </button>
        <button
          type="button"
          class="code-tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors text-[#52525b]"
          data-tab="js"
        >
          JavaScript / TypeScript
        </button>
        <button
          type="button"
          class="code-tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors text-[#52525b] inline-flex items-center gap-1.5"
          data-tab="colorjs"
        >
          <svg width="13" height="13" viewBox="0 -625 630 615" aria-hidden="true" class="shrink-0">
            <defs>
              <linearGradient id="cjs-tab-grad" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="50%" stop-color="#34d399" />
                <stop offset="100%" stop-color="#f97316" />
              </linearGradient>
            </defs>
            <path
              d="M 256.804 -16.594 L 256.637 -16.593 L 256.418 -16.266 L 256.085 -16.263 L 255.699 -15.935 L 255.2 -15.932 L 254.535 -15.927 L 253.704 -15.921 L 252.207 -16.885 L 249.615 -19.128 L 246.12 -22.623 L 241.063 -27.948 L 234.69 -35.011 L 226.63 -43.68 L 216.06 -54.946 L 203.34 -68.779 L 187.72 -87.114 L 168.963 -111.946 L 144.076 -150.984 L 114.692 -204.374 L 82.816 -270.829 L 52.134 -342.686 L 28.159 -416.979 L 11.891 -469.843 L 3.473 -513.066 L 1.438 -543.162 L 4.643 -563.843 L 5.859 -567.036 L 7.213 -569.939 L 8.771 -572.575 L 10.438 -574.905 L 12.285 -576.969 L 14.22 -578.754 L 16.315 -580.309 L 18.482 -581.618 L 20.756 -582.743 L 23.116 -583.667 L 25.566 -584.422 L 28.05 -585.009 L 30.633 -585.478 L 33.285 -585.851 L 36.008 -586.142 L 50.059 -586.754 L 64.335 -586.523 L 79.224 -585.616 L 95.269 -584.113 L 112.701 -582.069 L 131.858 -579.553 L 153.101 -576.592 L 176.586 -573.182 L 202.596 -569.364 L 231.17 -565.107 L 262.343 -560.441 L 295.958 -555.411 L 331.527 -550.115 L 368.06 -544.626 L 403.475 -539.334 L 437.943 -534.187 L 469.171 -529.561 L 496.768 -525.419 L 520.257 -521.894 L 539.92 -518.977 L 556.503 -516.489 L 570.88 -514.332 L 583.036 -512.508 L 592.866 -511.07 L 600.496 -509.926 L 606.437 -509.035 L 610.879 -508.368 L 613.777 -507.933 L 616.162 -507.576 L 618.025 -507.296 L 619.897 -507.015 L 621.507 -506.774 L 622.584 -506.612 L 623.123 -506.531 L 623.393 -506.491 Z"
              fill="url(#cjs-tab-grad)"
            />
          </svg>
          Color.js
        </button>
      </div>

      <!-- Python panel -->
      <div class="code-tab-panel rounded-b-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 overflow-x-auto" data-panel="python">
        <pre class="text-sm leading-relaxed font-mono"><code><span class="text-[#c084fc]">from</span> <span class="text-[#60a5fa]">helmlab</span> <span class="text-[#c084fc]">import</span> Helmlab

hl = Helmlab()

<span class="text-[#52525b]"># Generate a 10-shade palette from any color</span>
palette = hl.<span class="text-[#34d399]">palette</span>(<span class="text-[#fb923c]">"#3b82f6"</span>)

<span class="text-[#52525b]"># Color distance (Euclidean Lab — uncompressed)</span>
dist = hl.<span class="text-[#34d399]">delta_e</span>(<span class="text-[#fb923c]">"#ff0000"</span>, <span class="text-[#fb923c]">"#00ff00"</span>)

<span class="text-[#52525b]"># 32-step gradient (stays blue through the midpoint)</span>
grad = hl.<span class="text-[#34d399]">gradient</span>(<span class="text-[#fb923c]">"#0000ff"</span>, <span class="text-[#fb923c]">"#ffffff"</span>, <span class="text-[#f97316]">32</span>)

<span class="text-[#52525b]"># Tailwind-style semantic scale (50-950)</span>
scale = hl.<span class="text-[#34d399]">semantic_scale</span>(<span class="text-[#fb923c]">"#3b82f6"</span>)</code></pre>
      </div>

      <!-- JavaScript panel -->
      <div class="code-tab-panel hidden rounded-b-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 overflow-x-auto" data-panel="js">
        <pre class="text-sm leading-relaxed font-mono"><code><span class="text-[#c084fc]">import</span> {"{"} Helmlab {"}"} <span class="text-[#c084fc]">from</span> <span class="text-[#fb923c]">'helmlab'</span>;

<span class="text-[#c084fc]">const</span> hl = <span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Helmlab</span>();

<span class="text-[#52525b]">// Generate a 10-shade palette from any color</span>
<span class="text-[#c084fc]">const</span> palette = hl.<span class="text-[#34d399]">palette</span>(<span class="text-[#fb923c]">'#3b82f6'</span>);

<span class="text-[#52525b]">// Perceptual distance between two colors</span>
<span class="text-[#c084fc]">const</span> dist = hl.<span class="text-[#34d399]">deltaE</span>(<span class="text-[#fb923c]">'#ff0000'</span>, <span class="text-[#fb923c]">'#00ff00'</span>);

<span class="text-[#52525b]">// 32-step gradient (stays blue through the midpoint)</span>
<span class="text-[#c084fc]">const</span> grad = hl.<span class="text-[#34d399]">gradient</span>(<span class="text-[#fb923c]">'#0000ff'</span>, <span class="text-[#fb923c]">'#ffffff'</span>, <span class="text-[#f97316]">32</span>);

<span class="text-[#52525b]">// Tailwind-style semantic scale (50-950)</span>
<span class="text-[#c084fc]">const</span> scale = hl.<span class="text-[#34d399]">semanticScale</span>(<span class="text-[#fb923c]">'#3b82f6'</span>);</code></pre>
      </div>

      <!-- Color.js panel -->
      <div class="code-tab-panel hidden rounded-b-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 overflow-x-auto" data-panel="colorjs">
        <pre class="text-sm leading-relaxed font-mono"><code><span class="text-[#c084fc]">import</span> Color <span class="text-[#c084fc]">from</span> <span class="text-[#fb923c]">"colorjs.io"</span>;

<span class="text-[#52525b]">// Pending next Color.js release. 3 spaces: helmgen, helmgenlch, helmlab-metric.</span>
<span class="text-[#c084fc]">const</span> blue = <span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Color</span>(<span class="text-[#fb923c]">"helmgen"</span>, [<span class="text-[#f97316]">0.55</span>, <span class="text-[#f97316]">-0.04</span>, <span class="text-[#f97316]">-0.18</span>]);

<span class="text-[#52525b]">// Convert from anywhere — sRGB, P3, Lab, OKLab…</span>
<span class="text-[#c084fc]">const</span> hg = <span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Color</span>(<span class="text-[#fb923c]">"#3b82f6"</span>).<span class="text-[#34d399]">to</span>(<span class="text-[#fb923c]">"helmgen"</span>);

<span class="text-[#52525b]">// Smooth blue gradient — stays saturated mid-way (use GenSpace)</span>
<span class="text-[#c084fc]">const</span> grad = blue.<span class="text-[#34d399]">steps</span>(<span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Color</span>(<span class="text-[#fb923c]">"white"</span>), {"{"} space: <span class="text-[#fb923c]">"helmgen"</span>, steps: <span class="text-[#f97316]">32</span> {"}"});

<span class="text-[#52525b]">// Perceptual distance — uses MetricSpace's pair-dependent deltaE</span>
<span class="text-[#c084fc]">const</span> d = <span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Color</span>(<span class="text-[#fb923c]">"red"</span>).<span class="text-[#34d399]">deltaE</span>(<span class="text-[#fb923c]">"green"</span>, <span class="text-[#fb923c]">"Helmlab"</span>);</code></pre>
      </div>

      <!-- Technical stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">~2.5x</div>
          <div class="text-xs text-[#52525b]">OKLab cost</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">us/px</div>
          <div class="text-xs text-[#52525b]">per pixel</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">Exact</div>
          <div class="text-xs text-[#52525b]">invertibility</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">0 deps</div>
          <div class="text-xs text-[#52525b]">JS bundle ({claims.bundleKB}KB)</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.code-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      const wrapper = btn.closest('.code-tabs-wrapper');
      if (!wrapper || !tab) return;

      // Update buttons
      wrapper.querySelectorAll('.code-tab-btn').forEach((b) => {
        b.classList.remove('bg-white/[0.06]', 'text-[#fafafa]');
        b.classList.add('text-[#52525b]');
      });
      btn.classList.add('bg-white/[0.06]', 'text-[#fafafa]');
      btn.classList.remove('text-[#52525b]');

      // Update panels
      wrapper.querySelectorAll('.code-tab-panel').forEach((panel) => {
        if (panel.getAttribute('data-panel') === tab) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>

---
// CodeExamples — Python/JS tab component with minimal JS for tab switching
---

<section class="py-16 md:py-24" id="quickstart">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Quick Start</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">Works where you work</h2>
      <p class="text-[#a1a1aa] max-w-2xl mx-auto">
        Python and JavaScript with identical APIs. TypeScript types included. Zero dependencies in JS.
      </p>
    </div>

    <div class="code-tabs-wrapper max-w-3xl mx-auto">
      <!-- Tab buttons -->
      <div class="flex gap-1 mb-0 rounded-t-2xl border border-b-0 border-white/[0.06] bg-[#0c0c0f] p-1.5">
        <button
          type="button"
          class="code-tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors bg-white/[0.06] text-[#fafafa]"
          data-tab="python"
        >
          Python
        </button>
        <button
          type="button"
          class="code-tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors text-[#52525b]"
          data-tab="js"
        >
          JavaScript / TypeScript
        </button>
      </div>

      <!-- Python panel -->
      <div class="code-tab-panel rounded-b-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 overflow-x-auto" data-panel="python">
        <pre class="text-sm leading-relaxed font-mono"><code><span class="text-[#c084fc]">from</span> <span class="text-[#60a5fa]">helmlab</span> <span class="text-[#c084fc]">import</span> Helmlab

hl = Helmlab()

<span class="text-[#52525b]"># Generate a 10-shade palette from any color</span>
palette = hl.<span class="text-[#34d399]">palette</span>(<span class="text-[#fb923c]">"#3b82f6"</span>)

<span class="text-[#52525b]"># Perceptual distance between two colors</span>
dist = hl.<span class="text-[#34d399]">delta_e</span>(<span class="text-[#fb923c]">"#ff0000"</span>, <span class="text-[#fb923c]">"#00ff00"</span>)

<span class="text-[#52525b]"># 32-step gradient (smooth blue, not lavender)</span>
grad = hl.<span class="text-[#34d399]">gradient</span>(<span class="text-[#fb923c]">"#0000ff"</span>, <span class="text-[#fb923c]">"#ffffff"</span>, <span class="text-[#f97316]">32</span>)

<span class="text-[#52525b]"># Tailwind-style semantic scale (50-950)</span>
scale = hl.<span class="text-[#34d399]">semantic_scale</span>(<span class="text-[#fb923c]">"#3b82f6"</span>)</code></pre>
      </div>

      <!-- JavaScript panel -->
      <div class="code-tab-panel hidden rounded-b-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 overflow-x-auto" data-panel="js">
        <pre class="text-sm leading-relaxed font-mono"><code><span class="text-[#c084fc]">import</span> {"{"} Helmlab {"}"} <span class="text-[#c084fc]">from</span> <span class="text-[#fb923c]">'helmlab'</span>;

<span class="text-[#c084fc]">const</span> hl = <span class="text-[#c084fc]">new</span> <span class="text-[#60a5fa]">Helmlab</span>();

<span class="text-[#52525b]">// Generate a 10-shade palette from any color</span>
<span class="text-[#c084fc]">const</span> palette = hl.<span class="text-[#34d399]">palette</span>(<span class="text-[#fb923c]">'#3b82f6'</span>);

<span class="text-[#52525b]">// Perceptual distance between two colors</span>
<span class="text-[#c084fc]">const</span> dist = hl.<span class="text-[#34d399]">deltaE</span>(<span class="text-[#fb923c]">'#ff0000'</span>, <span class="text-[#fb923c]">'#00ff00'</span>);

<span class="text-[#52525b]">// 32-step gradient (smooth blue, not lavender)</span>
<span class="text-[#c084fc]">const</span> grad = hl.<span class="text-[#34d399]">gradient</span>(<span class="text-[#fb923c]">'#0000ff'</span>, <span class="text-[#fb923c]">'#ffffff'</span>, <span class="text-[#f97316]">32</span>);

<span class="text-[#52525b]">// Tailwind-style semantic scale (50-950)</span>
<span class="text-[#c084fc]">const</span> scale = hl.<span class="text-[#34d399]">semanticScale</span>(<span class="text-[#fb923c]">'#3b82f6'</span>);</code></pre>
      </div>

      <!-- Technical stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">~2.5x</div>
          <div class="text-xs text-[#52525b]">OKLab cost</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">us/px</div>
          <div class="text-xs text-[#52525b]">per pixel</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">Exact</div>
          <div class="text-xs text-[#52525b]">invertibility</div>
        </div>
        <div class="text-center">
          <div class="text-lg font-bold text-[#fafafa]">0 deps</div>
          <div class="text-xs text-[#52525b]">JS bundle (11.6KB)</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.code-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      const wrapper = btn.closest('.code-tabs-wrapper');
      if (!wrapper || !tab) return;

      // Update buttons
      wrapper.querySelectorAll('.code-tab-btn').forEach((b) => {
        b.classList.remove('bg-white/[0.06]', 'text-[#fafafa]');
        b.classList.add('text-[#52525b]');
      });
      btn.classList.add('bg-white/[0.06]', 'text-[#fafafa]');
      btn.classList.remove('text-[#52525b]');

      // Update panels
      wrapper.querySelectorAll('.code-tab-panel').forEach((panel) => {
        if (panel.getAttribute('data-panel') === tab) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>

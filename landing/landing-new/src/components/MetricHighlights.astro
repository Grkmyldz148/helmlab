---
// MetricHighlights — 6 key metric cards in a responsive grid
import { claims, winShort, totalMetrics, independentStr, ciede2000ImprovementPct, munsellMult } from '../data/claims';
const metrics = [
  {
    value: claims.stress.metricSpace.combvd,
    unit: "",
    designerLabel: "Predicts what humans see",
    designerDesc: "When you ask \"do these two colors match?\" — Helmlab's answer agrees with human observers better than any other tool.",
    devLabel: `STRESS score on COMBVD (${claims.datasets.combvdPairs.toLocaleString()} pairs)`,
    devDesc: `${ciede2000ImprovementPct()}% better than CIEDE2000`,
  },
  {
    value: winShort(),
    unit: "",
    designerLabel: "Wins almost every test",
    designerDesc: `Out of ${totalMetrics()} quality checks — gradient smoothness, gamut coverage, palette uniformity — Helmlab wins ${claims.record.genspace}. OKLab wins ${claims.record.oklab}.`,
    devLabel: `${totalMetrics()} metrics, 13 categories`,
    devDesc: `Including ${independentStr()} on independent 3rd-party datasets`,
  },
  {
    value: "360/360",
    unit: "",
    designerLabel: "No gamut holes",
    designerDesc: "Every hue angle has a clean, usable boundary. No sudden clipping artifacts when you push saturation.",
    devLabel: "sRGB + P3 valid cusp coverage",
    devDesc: `OKLab: ${claims.cusps.sRGB.oklab}/360 sRGB, ${claims.cusps.P3.oklab}/360 P3`,
  },
  {
    value: munsellMult(),
    unit: "x",
    designerLabel: "Even lightness steps",
    designerDesc: "Slightly more even 50-950 palette steps — the dark end is a little less compressed than OKLab's. A small but measurable difference.",
    devLabel: `Munsell Value: ${claims.munsellValueCV.genspace}% vs ${claims.munsellValueCV.oklab}%`,
    devDesc: "Uniform L channel by construction",
  },
  {
    value: claims.blueWhiteGR.genspace,
    unit: "",
    designerLabel: "Blue stays a touch more saturated",
    designerDesc: "Blue-to-white gradients keep slightly more saturation through the middle than OKLab — both stay blue (~220°), Helmlab a little more vivid.",
    devLabel: "Blue-to-White midpoint G/R ratio",
    devDesc: `OKLab: ${claims.blueWhiteGR.oklab} (slightly less saturated)`,
  },
  {
    value: "10",
    unit: null,
    sup: "-15",
    designerLabel: "Perfect neutrals",
    designerDesc: "Gray is truly gray. No color tint sneaking into your neutral palette, ever.",
    devLabel: "Achromatic purity (D65 C*)",
    devDesc: "~10⁸× better than OKLab",
  },
];
---

<section class="py-16 md:py-24" id="benchmarks">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">Key Metrics</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">Numbers that speak for themselves</h2>
      <p class="text-[#a1a1aa] max-w-2xl mx-auto">
        ColorBench: {totalMetrics()} metrics, {claims.gradientPairs.toLocaleString()} gradient pairs, 3 gamuts, float64 precision. Head-to-head vs OKLab.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {metrics.map((m) => (
        <div class="group rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 hover:border-white/[0.12] transition-colors">
          <div class="text-4xl font-bold text-[#fafafa] mb-1">
            {m.value}
            {m.unit !== null && !m.sup && <span class="text-2xl text-[#a1a1aa]">{m.unit}</span>}
            {m.sup && <sup class="text-lg text-[#a1a1aa]">{m.sup}</sup>}
          </div>
          <div class="text-sm text-[#fafafa] mb-1">{m.devLabel}</div>
          <div class="text-xs text-[#52525b]">{m.devDesc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

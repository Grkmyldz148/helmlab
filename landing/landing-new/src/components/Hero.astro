---
// Hero section — full viewport height with animated grid background
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated CSS grid background -->
  <div class="hero-grid absolute inset-0 z-0"></div>
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-transparent via-[#09090b]/60 to-[#09090b]"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center py-24">
    <!-- Version badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 text-sm text-[#a1a1aa] mb-3">
      v0.12.0 — MetricSpace + GenSpace
    </div>

    <!-- Color.js badge -->
    <div class="mb-8">
      <a
        href="https://colorjs.io/docs/spaces.html#helmgen"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 py-1.5 text-xs sm:text-sm text-[#a1a1aa] hover:text-white hover:border-white/[0.16] transition-colors"
        aria-label="Helmlab is shipped in Color.js — view in Color.js docs"
      >
        <svg width="14" height="14" viewBox="0 -625 630 615" aria-hidden="true" class="shrink-0">
          <defs>
            <linearGradient id="cjs-tongue-grad" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0%" stop-color="#60a5fa" />
              <stop offset="50%" stop-color="#34d399" />
              <stop offset="100%" stop-color="#f97316" />
            </linearGradient>
          </defs>
          <path
            d="M 256.804 -16.594 L 256.637 -16.593 L 256.418 -16.266 L 256.085 -16.263 L 255.699 -15.935 L 255.2 -15.932 L 254.535 -15.927 L 253.704 -15.921 L 252.207 -16.885 L 249.615 -19.128 L 246.12 -22.623 L 241.063 -27.948 L 234.69 -35.011 L 226.63 -43.68 L 216.06 -54.946 L 203.34 -68.779 L 187.72 -87.114 L 168.963 -111.946 L 144.076 -150.984 L 114.692 -204.374 L 82.816 -270.829 L 52.134 -342.686 L 28.159 -411.679 L 11.891 -469.843 L 3.473 -513.066 L 1.438 -543.162 L 4.643 -563.843 L 5.859 -567.036 L 7.213 -569.939 L 8.771 -572.575 L 10.438 -574.905 L 12.285 -576.969 L 14.22 -578.754 L 16.315 -580.309 L 18.482 -581.618 L 20.756 -582.743 L 23.116 -583.667 L 25.566 -584.422 L 28.05 -585.009 L 30.633 -585.478 L 33.285 -585.851 L 36.008 -586.142 L 50.059 -586.754 L 64.335 -586.523 L 79.224 -585.616 L 95.269 -584.113 L 112.701 -582.069 L 131.858 -579.553 L 153.101 -576.592 L 176.586 -573.182 L 202.596 -569.364 L 231.17 -565.107 L 262.343 -560.441 L 295.958 -555.411 L 331.527 -550.115 L 368.06 -544.626 L 403.475 -539.334 L 437.943 -534.187 L 469.171 -529.561 L 496.768 -525.419 L 520.257 -521.894 L 539.92 -518.977 L 556.503 -516.489 L 570.88 -514.332 L 583.036 -512.508 L 592.866 -511.07 L 600.496 -509.926 L 606.437 -509.035 L 610.879 -508.368 L 613.777 -507.933 L 616.162 -507.576 L 618.025 -507.296 L 619.897 -507.015 L 621.507 -506.774 L 622.584 -506.612 L 623.123 -506.531 L 623.393 -506.491 Z"
            fill="url(#cjs-tongue-grad)"
          />
          <polygon points="496.35,-525.54 98.6,-577.67 175.44,-157.89" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="22" stroke-linejoin="round" />
        </svg>
        <span>Merged into <span class="text-white font-medium">Color.js</span></span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-60">
          <path d="M7 17L17 7M17 7H8M17 7V16" />
        </svg>
      </a>
    </div>

    <!-- Single H1 for SEO (contains both audience variants via spans) -->
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] mb-6">
      <span class="for-designer">
        Your Colors Deserve<br /><span class="bg-gradient-to-r from-[#f97316] to-[#fb923c] bg-clip-text text-transparent">Better Math</span>
      </span>
      <span class="for-dev">
        Two Purpose-Built<br /><span class="bg-gradient-to-r from-[#f97316] to-[#fb923c] bg-clip-text text-transparent">Lab Spaces</span>
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="for-designer text-lg sm:text-xl text-[#a1a1aa] max-w-2xl mx-auto mb-8">
      You know the problem: blue-to-white gradients go purple. Dark palettes have muddy holes.
      Yellows look washed out. <strong class="text-white">Helmlab fixes all of that.</strong>
    </p>
    <p class="for-dev text-lg sm:text-xl text-[#a1a1aa] max-w-2xl mx-auto mb-8">
      GenSpace for generation. MetricSpace for measurement.<br />
      Same library, two pipelines optimized for different objectives.
    </p>

    <!-- Score badge -->
    <div class="for-designer inline-flex items-center gap-3 rounded-full bg-[#f97316]/10 border border-[#f97316]/20 px-5 py-2.5 mb-8">
      <span class="text-[#f97316] font-bold text-lg">Wins 65 out of 90</span>
      <span class="text-[#a1a1aa] text-sm">quality tests vs OKLab</span>
    </div>
    <div class="for-dev inline-flex items-center gap-3 rounded-full bg-[#f97316]/10 border border-[#f97316]/20 px-5 py-2.5 mb-8">
      <span class="text-[#f97316] font-bold text-lg">65-9</span>
      <span class="text-[#a1a1aa] text-sm">vs OKLab on 90 benchmarks (15 ties)</span>
    </div>

    <!-- Install commands -->
    <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 mt-2">
      <div class="install-cmd group flex items-center gap-2 rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 font-mono text-sm">
        <span class="text-[#a1a1aa] select-none">$</span>
        <code class="text-[#fafafa]">pip install helmlab</code>
        <button
          type="button"
          class="copy-btn ml-2 p-1 rounded-md text-[#52525b] hover:text-[#fafafa] hover:bg-white/[0.06] transition-colors"
          data-copy="pip install helmlab"
          aria-label="Copy pip install command"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="install-cmd group flex items-center gap-2 rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 font-mono text-sm">
        <span class="text-[#a1a1aa] select-none">$</span>
        <code class="text-[#fafafa]">npm install helmlab</code>
        <button
          type="button"
          class="copy-btn ml-2 p-1 rounded-md text-[#52525b] hover:text-[#fafafa] hover:bg-white/[0.06] transition-colors"
          data-copy="npm install helmlab"
          aria-label="Copy npm install command"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    animation: grid-drift 20s linear infinite;
  }

  @keyframes grid-drift {
    0% { background-position: 0 0; }
    100% { background-position: 64px 64px; }
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          const svg = btn.querySelector('svg');
          if (svg) {
            const original = svg.innerHTML;
            svg.innerHTML = '<polyline points="20 6 9 17 4 12" />';
            setTimeout(() => { svg.innerHTML = original; }, 1500);
          }
        });
      }
    });
  });
</script>

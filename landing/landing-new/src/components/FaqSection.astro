---
// FaqSection — accordion FAQ using CSS-only details/summary
import { claims, winShort, totalMetrics, independentStr, ciede2000ImprovementPct, oklabNearAchromAdvantagePct, oklabDeutanAdvantagePct } from '../data/claims';
const faqs = [
  {
    q: "What's the difference between GenSpace and MetricSpace?",
    a: `GenSpace is optimized for visual quality in generation tasks: palette creation, gradient interpolation, gamut mapping, and animation. ~${claims.genParams} parameters, depressed cubic transfer. MetricSpace is optimized for predicting perceptual color differences. ${claims.metricParams} parameters, full enrichment pipeline with H-K correction, pair-dependent SL/SC weighting. Same library, two pipelines.`,
  },
  {
    q: "Is Helmlab a replacement for OKLab?",
    a: `For most generation tasks, yes. GenSpace scores ${winShort()} against OKLab across ${totalMetrics()} benchmarks, including ${independentStr()} on independent datasets OKLab was optimized on. OKLab remains better for: near-achromatic gradients (${oklabNearAchromAdvantagePct()}% better CV), CVD deutan palettes (${oklabDeutanAdvantagePct()}%), native CSS oklch(), or minimal bundle size (~${claims.oklabBundleKB}KB vs ${claims.bundleKB}KB).`,
  },
  {
    q: "How was it optimized? Is there overfitting?",
    a: `CMA-ES optimization on COMBVD (${claims.datasets.combvdPairs.toLocaleString()} pairs). Proper holdout test: +1.8 STRESS gap between train and held-out 20% split. Published STRESS ${claims.stress.metricSpace.combvd} is a training metric; cross-validated estimate ~${claims.overfit.crossValidated}. Still beats CIEDE2000 (${claims.stress.ciede2000.combvd}) and every other Lab-only baseline. On the small held-out MacAdam 1974 set (${claims.datasets.macadamPairs} pairs, never trained on) MetricSpace = ${claims.stress.metricSpace.macadam} vs CAM16-UCS ${claims.stress.cam16ucs.macadam} — CAM16 leads by 0.80 STRESS due to its appearance-model formulation matching MacAdam's controlled-viewing conditions. Across the COMBVD+MacAdam average MetricSpace remains #1 (${claims.stress.metricSpace.average} vs CIECAM02-UCS's ${claims.stress.ciecam02ucs.average}). Our own human-feedback set is rank-order-only after an internal audit (5-level categorical ratings break STRESS) — MetricSpace ranks it at Spearman ${claims.humanFbRank.spearman.metricSpace} vs CIEDE2000's ${claims.humanFbRank.spearman.ciede2000}. Full analysis in BENCHMARK.md.`,
  },
  {
    q: "How does this relate to Color.js?",
    a: `Helmlab was merged into Color.js master in April 2026: three spaces (helmgen, helmgenlch, helmlab-metric) plus a custom 'Helmlab' deltaE method. The published colorjs.io@${claims.external.colorjsPublishedVersion} does NOT include it yet — it ships in the next release; until then use 'npm install github:color-js/color.js' or stick with the helmlab package below. The helmlab npm package is the right pick if you want a tiny zero-dep bundle (${claims.bundleKB} KB) with palette/gradient/semanticScale helpers. The math is identical in both.`,
  },
  {
    q: "Can I use it in CSS?",
    a: "Yes — install postcss-helmlab and write helmlab(L a b), helmlch(L C h), helmgen(...), or helmgenlch(...) directly in your stylesheets. The plugin emits sRGB inline plus @supports-wrapped color(display-p3 ...) and color(rec2020 ...) overrides at build time, so older browsers fall back gracefully and modern browsers receive the widest gamut they can render. This site dogfoods it.",
  },
  {
    q: "What about browser support?",
    a: `ES module, zero dependencies, ${claims.bundleKB}KB gzipped. Works in all modern browsers and Node.js. TypeScript types included. Outputs standard hex/RGB. helmlab.js is tree-shakeable.`,
  },
  {
    q: "Is it open source?",
    a: `${claims.license} licensed. GitHub: ${claims.external.repo}. Full benchmark methodology (ColorBench), optimization scripts, and psychophysical datasets are published. Research paper: arxiv.org/abs/${claims.external.arxivId}.`,
  },
];
---

<section class="py-16 md:py-24" id="faq">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-xs uppercase tracking-widest text-[#f97316] font-medium">FAQ</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="faq-item group rounded-2xl border border-white/[0.06] bg-[#0c0c0f] overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer select-none px-6 py-5 text-sm font-medium text-[#fafafa] hover:bg-white/[0.02] transition-colors list-none">
            <span>{faq.q}</span>
            <svg
              class="shrink-0 ml-4 w-4 h-4 text-[#52525b] transition-transform duration-300 group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
          </summary>
          <div class="faq-content">
            <div class="faq-inner">
              <p class="px-6 pb-5 text-sm text-[#a1a1aa] leading-relaxed">{faq.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>


---
// InstallBlock — two install commands side by side
---

<section class="py-16 md:py-24" id="install">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Get Started</h2>
      <p class="text-[#a1a1aa]">Python and JavaScript. Same API. Same results.</p>
    </div>

    <div class="flex flex-col sm:flex-row flex-wrap items-stretch justify-center gap-4 max-w-3xl mx-auto">
      <!-- pip -->
      <div class="w-full sm:w-auto flex-1 flex items-center gap-3 rounded-2xl border border-white/[0.06] bg-[#0c0c0f] px-6 py-4">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <span class="text-[#f97316] text-sm font-bold shrink-0">Python</span>
          <code class="font-mono text-sm text-[#fafafa] truncate">pip install helmlab</code>
        </div>
        <button
          type="button"
          class="install-copy-btn shrink-0 p-2 rounded-lg text-[#52525b] hover:text-[#fafafa] hover:bg-white/[0.06] transition-colors"
          data-copy="pip install helmlab"
          aria-label="Copy pip install command"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>

      <!-- npm -->
      <div class="w-full sm:w-auto flex-1 flex items-center gap-3 rounded-2xl border border-white/[0.06] bg-[#0c0c0f] px-6 py-4">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <span class="text-[#34d399] text-sm font-bold shrink-0">JS / TS</span>
          <code class="font-mono text-sm text-[#fafafa] truncate">npm install helmlab</code>
        </div>
        <button
          type="button"
          class="install-copy-btn shrink-0 p-2 rounded-lg text-[#52525b] hover:text-[#fafafa] hover:bg-white/[0.06] transition-colors"
          data-copy="npm install helmlab"
          aria-label="Copy npm install command"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Color.js alternative -->
    <div class="mt-4 max-w-3xl mx-auto">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 rounded-2xl border border-white/[0.06] bg-white/[0.015] px-6 py-4">
        <div class="flex items-center gap-2 text-sm text-[#a1a1aa] shrink-0">
          <svg width="16" height="16" viewBox="0 -625 630 615" aria-hidden="true" class="shrink-0">
            <defs>
              <linearGradient id="cjs-install-grad" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="50%" stop-color="#34d399" />
                <stop offset="100%" stop-color="#f97316" />
              </linearGradient>
            </defs>
            <path
              d="M 256.804 -16.594 L 256.637 -16.593 L 256.418 -16.266 L 256.085 -16.263 L 255.699 -15.935 L 255.2 -15.932 L 254.535 -15.927 L 253.704 -15.921 L 252.207 -16.885 L 249.615 -19.128 L 246.12 -22.623 L 241.063 -27.948 L 234.69 -35.011 L 226.63 -43.68 L 216.06 -54.946 L 203.34 -68.779 L 187.72 -87.114 L 168.963 -111.946 L 144.076 -150.984 L 114.692 -204.374 L 82.816 -270.829 L 52.134 -342.686 L 28.159 -411.679 L 11.891 -469.843 L 3.473 -513.066 L 1.438 -543.162 L 4.643 -563.843 L 5.859 -567.036 L 7.213 -569.939 L 8.771 -572.575 L 10.438 -574.905 L 12.285 -576.969 L 14.22 -578.754 L 16.315 -580.309 L 18.482 -581.618 L 20.756 -582.743 L 23.116 -583.667 L 25.566 -584.422 L 28.05 -585.009 L 30.633 -585.478 L 33.285 -585.851 L 36.008 -586.142 L 50.059 -586.754 L 64.335 -586.523 L 79.224 -585.616 L 95.269 -584.113 L 112.701 -582.069 L 131.858 -579.553 L 153.101 -576.592 L 176.586 -573.182 L 202.596 -569.364 L 231.17 -565.107 L 262.343 -560.441 L 295.958 -555.411 L 331.527 -550.115 L 368.06 -544.626 L 403.475 -539.334 L 437.943 -534.187 L 469.171 -529.561 L 496.768 -525.419 L 520.257 -521.894 L 539.92 -518.977 L 556.503 -516.489 L 570.88 -514.332 L 583.036 -512.508 L 592.866 -511.07 L 600.496 -509.926 L 606.437 -509.035 L 610.879 -508.368 L 613.777 -507.933 L 616.162 -507.576 L 618.025 -507.296 L 619.897 -507.015 L 621.507 -506.774 L 622.584 -506.612 L 623.123 -506.531 L 623.393 -506.491 Z"
              fill="url(#cjs-install-grad)"
            />
          </svg>
          Merged into <span class="text-white font-medium">Color.js</span>
        </div>
        <div class="hidden sm:block h-4 w-px bg-white/[0.08]"></div>
        <span class="text-xs sm:text-sm text-[#a1a1aa]">3 spaces on master — pending next release</span>
        <a
          href="https://colorjs.io/docs/spaces.html#helmgen"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-auto sm:ml-2 shrink-0 inline-flex items-center gap-1 text-xs text-[#a1a1aa] hover:text-white transition-colors"
        >
          docs
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H8M17 7V16" />
          </svg>
        </a>
      </div>
    </div>

    <div class="text-center mt-6">
      <div class="flex items-center justify-center gap-6 text-xs text-[#52525b]">
        <span>MIT License</span>
        <span>Zero Dependencies (JS)</span>
        <span>TypeScript Included</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.install-copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          const svg = btn.querySelector('svg');
          if (svg) {
            const original = svg.innerHTML;
            svg.innerHTML = '<polyline points="20 6 9 17 4 12" />';
            setTimeout(() => { svg.innerHTML = original; }, 1500);
          }
        });
      }
    });
  });
</script>

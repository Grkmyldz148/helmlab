---
// UseCases — when to use / when not to use Helmlab
import { claims, munsellMult, hueDriftReductionPct, cuspSmoothMult, darkGradientPct, yellowChromaPct, oklabNearAchromAdvantagePct, oklabDeutanAdvantagePct, bundleRatio } from '../data/claims';
const useCases = [
  {
    title: "Design System Palettes",
    desc: `Munsell Value CV: ${claims.munsellValueCV.genspace}% vs OKLab ${claims.munsellValueCV.oklab}%. ${munsellMult()}x better lightness uniformity.`,
  },
  {
    title: "Gradient Interpolation",
    desc: `${hueDriftReductionPct()}% less max hue drift, 18% better cross-lightness CV. G/R=${claims.blueWhiteGR.genspace} (OKLab: ${claims.blueWhiteGR.oklab}).`,
  },
  {
    title: "Gamut Mapping",
    desc: `360/360 cusps, 0 mono violations, cusp smoothness ${claims.cuspSmoothness.genspace} (OKLab: ${claims.cuspSmoothness.oklab}). ${cuspSmoothMult()}x smoother.`,
  },
  {
    title: "Data Visualization",
    desc: "Higher min pairwise delta-E (14.50 vs 14.34). Better perceptual distinctiveness.",
  },
  {
    title: "Dark UI Themes",
    desc: `Dark gradient CV: ${claims.darkGradientCV.genspace}% vs OKLab ${claims.darkGradientCV.oklab}%. ${darkGradientPct()}% better uniformity in L<0.4.`,
  },
  {
    title: "Color Animation",
    desc: `Frame-to-frame CV: ${claims.frameToFrameCV.genspace}% vs ${claims.frameToFrameCV.oklab}%. Fewer quantization artifacts in 8-bit.`,
  },
  {
    title: "Wide Gamut (P3, Rec.2020)",
    desc: `P3 cusps: 360/360 (OKLab: ${claims.cusps.P3.oklab}). Zero P3 mono violations (OKLab: ${claims.oklabP3MonoViol}).`,
  },
  {
    title: "Blue / Yellow Design",
    desc: `Blue G/R=${claims.blueWhiteGR.genspace} (OKLab: ${claims.blueWhiteGR.oklab}). Yellow chroma ${claims.yellowChroma.genspace} (OKLab: ${claims.yellowChroma.oklab}, +${yellowChromaPct()}%).`,
  },
];

const antiCases = [
  {
    title: "Near-Achromatic Gradients",
    recommend: "OKLab",
    desc: `Near-achromatic CV: OKLab ${claims.nearAchromCV.oklab}% vs Helmlab ${claims.nearAchromCV.genspace}%. ${oklabNearAchromAdvantagePct()}% gap.`,
  },
  {
    title: "CVD Deutan Palettes",
    recommend: "OKLab",
    desc: `Deutan min step delta-E: OKLab ${claims.deutanStep.oklab} vs Helmlab ${claims.deutanStep.genspace}. ${oklabDeutanAdvantagePct()}% gap.`,
  },
  {
    title: "CSS oklch() Required",
    recommend: "OKLab",
    desc: "oklch() is in CSS Color Level 4. Zero bundle cost.",
  },
  {
    title: "HDR / PQ Content",
    recommend: "Jzazbz",
    desc: "Perceptual quantization for luminance >1000 cd/m2. Untested territory.",
  },
  {
    title: "Minimal Bundle Size",
    recommend: "OKLab",
    desc: `OKLab: ~${claims.oklabBundleKB}KB. Helmlab: ${claims.bundleKB}KB gzipped. ~${bundleRatio()}x larger.`,
  },
  {
    title: "CIE Lab Hue Compatibility",
    recommend: "CIE Lab",
    desc: `Legacy system interop. Hue agreement: CIE Lab 0 deg vs Helmlab ${claims.hueAgreementVsCieLab} deg.`,
  },
];
---

<section class="py-16 md:py-24" id="use-cases">
  <div class="max-w-6xl mx-auto px-6">
    <!-- When to use -->
    <div class="mb-20">
      <div class="text-center mb-12 md:mb-16">
        <span class="text-xs uppercase tracking-widest text-[#34d399] font-medium">Recommended</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">When to Use Helmlab</h2>
        <p class="text-[#a1a1aa] max-w-2xl mx-auto">
          Tasks where GenSpace or MetricSpace measurably outperforms alternatives.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {useCases.map((uc) => (
          <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-5 hover:border-[#34d399]/20 transition-colors">
            <h3 class="text-sm font-semibold text-[#fafafa] mb-2">{uc.title}</h3>
            <p class="text-xs text-[#a1a1aa] leading-relaxed">{uc.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- When NOT to use -->
    <div>
      <div class="text-center mb-12 md:mb-16">
        <span class="text-xs uppercase tracking-widest text-[#f87171] font-medium">Honest</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">When NOT to Use Helmlab</h2>
        <p class="text-[#a1a1aa] max-w-2xl mx-auto">
          We believe in honest recommendations. These tools are better for specific use cases.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {antiCases.map((ac) => (
          <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-[#fafafa]">{ac.title}</h3>
              <span class="text-[10px] uppercase tracking-wider rounded-full bg-white/[0.04] border border-white/[0.06] px-2 py-0.5 text-[#a1a1aa] whitespace-nowrap">
                Use {ac.recommend}
              </span>
            </div>
            <p class="text-xs text-[#52525b] leading-relaxed">{ac.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

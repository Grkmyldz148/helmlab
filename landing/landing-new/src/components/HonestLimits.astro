---
// HonestLimits — transparent about where we lose
import { claims, totalMetrics } from '../data/claims';
import { genspaceResults } from '../data/genspace-results';
const metricLosses = [
  {
    title: "COMBVD sub-datasets",
    detail: "CIEDE2000 beats MetricSpace on LEEDS (19.25 vs 21.84), RIT-DuPont (19.47 vs 21.90), and WITT (30.22 vs 30.93). Our lead comes from the larger BFD-P datasets.",
  },
  {
    title: "Mild overfitting",
    detail: `${claims.metricParams} params on ${claims.datasets.combvdPairs.toLocaleString()} data points. Train/test gap of +1.8 STRESS. Published ${claims.stress.metricSpace.combvd} is a training metric; cross-validated estimate is ~${claims.overfit.crossValidated}. Still #1 on COMBVD, HumFB, and the 3-dataset average; CAM16-UCS narrowly leads on the ${claims.datasets.macadamPairs}-pair MacAdam set.`,
  },
  {
    title: "No HDR optimization",
    detail: "Jzazbz was designed for HDR/WCG. MetricSpace v21 is optimized for SDR psychophysical datasets. HDR color difference prediction is untested.",
  },
  {
    title: "No surround adaptation",
    detail: "CAM16 models viewing conditions (dark/dim/light surround). MetricSpace has basic parameters but is not optimized for cross-surround.",
  },
];

// Derived from the canonical ColorBench table — every metric OKLab wins,
// no hand-picked list. Notes are the only hand-written part.
const lossNotes: Record<string, string> = {
  "Worst-case gradient CV": "Single worst pair regresses. Tail case, not typical.",
  "Bright gradient CV (L>0.6)": "Marginal. Bright-end steps slightly less even.",
  "Near-achromatic gradient CV": "Real weakness. Grays less uniform.",
  "CVD deutan min step dE": "Real weakness. Green-blind see less distinction.",
  "Data viz min pairwise dE": "Slightly lower minimum palette separation.",
  "Red-White midpoint G-B": "Effectively tied.",
  "Primary hue disc (sRGB)": "Hue jumps at sRGB primaries.",
  "Primary hue disc (P3)": "Same issue in Display P3.",
  "Ebner-Fairchild hue surfaces (max)": "Slightly worse worst-case hue surface.",
};
const genLosses = genspaceResults
  .filter((m) => m.winner === "oklab")
  .map((m) => {
    const ours = Number(m.genspace);
    const theirs = Number(m.oklab);
    const gap = m.lowerIsBetter ? (ours - theirs) / theirs : (theirs - ours) / ours;
    return { metric: m.name, gap: `${Math.round(gap * 100)}%`, note: lossNotes[m.name] ?? "" };
  });
---

<section class="py-16 md:py-24" id="honest-limits">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-xs uppercase tracking-widest text-[#f87171] font-medium">Transparency</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">Where We Lose</h2>
      <p class="text-[#a1a1aa] max-w-2xl mx-auto">
        No color space wins everywhere. Here are our genuine weaknesses, documented publicly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- MetricSpace losses -->
      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#60a5fa]"></span>
          Where MetricSpace Loses
        </h3>
        <div class="space-y-4">
          {metricLosses.map((item) => (
            <div class="border-l-2 border-white/[0.06] pl-4">
              <div class="text-sm font-medium text-[#fafafa] mb-1">{item.title}</div>
              <div class="text-xs text-[#52525b] leading-relaxed">{item.detail}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- GenSpace losses -->
      <div class="rounded-2xl border border-white/[0.06] bg-[#0c0c0f] p-6 md:p-8">
        <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#34d399]"></span>
          Where GenSpace Loses
          <span class="text-xs text-[#52525b] font-normal ml-auto">{claims.record.oklab} of {totalMetrics()} vs OKLab</span>
        </h3>
        <div class="space-y-3">
          {genLosses.map((item) => (
            <div class="flex items-start gap-3 text-xs">
              <div class="min-w-0 flex-1">
                <span class="text-[#a1a1aa] font-medium">{item.metric}</span>
                <span class="text-[#52525b] ml-1">— {item.note}</span>
              </div>
              <span class={`shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium ${
                parseInt(item.gap) > 10
                  ? "bg-[#f87171]/10 text-[#f87171]"
                  : "bg-white/[0.04] text-[#52525b]"
              }`}>
                -{item.gap}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

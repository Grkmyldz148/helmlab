{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "f = (hex) => hl.genFromHex(hex)",
 "T4-physical-mix": "(a, b) => { const L = c => c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4, G = c => c <= 0.0031308 ? c * 12.92 : 1.055 * c ** (1/2.4) - 0.055, P = h => [1, 3, 5].map(i => L(parseInt(h.slice(i, i+2), 16) / 255)), [A, B] = [P(a), P(b)]; return '#' + A.map((_, i) => Math.round(G((A[i] + B[i]) / 2) * 255).toString(16).padStart(2, '0')).join(''); }",
 "T5-hue-wrap": "(h1, h2, t) => ((h1 + ((h2 - h1 + 540) % 360 - 180) * t) % 360 + 360) % 360",
 "T6-lch-distance": "(lch1, lch2) => ((lch2[0]-lch1[0])**2 + (lch2[1]*Math.cos(lch2[2]*Math.PI/180) - lch1[1]*Math.cos(lch1[2]*Math.PI/180))**2 + (lch2[1]*Math.sin(lch2[2]*Math.PI/180) - lch1[1]*Math.sin(lch1[2]*Math.PI/180))**2)**0.5",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the 2.3 noticeability threshold and unreliable for low-chroma grays where humans disagree most.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab` — distant hues need the rectangular form to stay on a straight line; LCh detours through every intermediate hue.",
 "T13-wcag": "function f(h1,h2){const getLum=h=>{const x=parseInt(h.slice(1),16),r=((x>>16)&255)/255,g=((x>>8)&255)/255,b=(x&255)/255,m=v=>v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4);return.2126*m(r)+.7152*m(g)+.0722*m(b)},l1=getLum(h1),l2=getLum(h2);return(Math.max(l1,l2)+.05)/(Math.min(l1,l2)+.05)}",
 "T14-darken": "(hex) => ((lch) => hl.genToHex(hl.genFromLch([Math.max(0, lch[0] - 0.2), lch[1], lch[2]])))(hl.genToLch(hl.genFromHex(hex)))",
 "T15-lightness-sort": "(hexArray) => hexArray.sort((a, b) => hl.genToLch(hl.genFromHex(a))[0] - hl.genToLch(hl.genFromHex(b))[0])",
 "T16-circular-mean": "const circularMean = angles => { const r = angles.map(a => a * Math.PI / 180); const s = r.reduce((x, y) => x + Math.sin(y), 0) / angles.length; const c = r.reduce((x, y) => x + Math.cos(y), 0) / angles.length; return (Math.atan2(s, c) * 180 / Math.PI + 360) % 360; }",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(h1, h2) => Math.min(Math.abs(h1 - h2), 360 - Math.abs(h1 - h2))",
 "T19-cat": "Chromatic adaptation.",
 "T20-hsv-contrast": "No — HSV Value is not perceptually uniform (yellow vs blue at same V differ wildly); use WCAG's contrast ratio formula or CIEDE2000 instead."

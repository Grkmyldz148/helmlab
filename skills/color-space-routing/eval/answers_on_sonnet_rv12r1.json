 "T4-physical-mix": "function f(hexA,hexB){const p=h=>[parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255];const lin=c=>c<=0.04045?c/12.92:((c+0.055)/1.055)**2.4;const gam=c=>c<=0.0031308?12.92*c:1.055*c**(1/2.4)-0.055;const a=p(hexA).map(lin),b=p(hexB).map(lin);return'#'+a.map((v,i)=>Math.round(gam((v+b[i])/2)*255).toString(16).padStart(2,'0')).join('')}",
 "T5-hue-wrap": "function f(h1,h2,t){let d=((h2-h1)%360+540)%360-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "((c1,c2)=>Math.sqrt((c1[0]-c2[0])**2+(c1[1]*Math.cos(c1[2]*Math.PI/180)-c2[1]*Math.cos(c2[2]*Math.PI/180))**2+(c1[1]*Math.sin(c1[2]*Math.PI/180)-c2[1]*Math.sin(c2[2]*Math.PI/180))**2))([0.5,0.1,10],[0.5,0.1,350])",

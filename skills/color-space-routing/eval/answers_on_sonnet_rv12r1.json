 "T13-wcag": "function f(fg,bg){const l=h=>{const[r,g,b]=[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)/255).map(c=>c<=.04045?c/12.92:((c+.055)/1.055)**2.4);return.2126*r+.7152*g+.0722*b};const[L1,L2]=[l(fg),l(bg)].sort((a,b)=>b-a);return(L1+.05)/(L2+.05)}",
 "T14-darken": "f = hex => { const [L, C, h] = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, L - 0.15), C, h])); }",

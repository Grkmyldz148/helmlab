 "T13-wcag": "function f(h1,h2){const L=h=>{const n=parseInt(h.slice(1),16),[r,g,b]=[(n>>16&255)/255,(n>>8&255)/255,(n&255)/255];return[r,g,b].map(c=>c<=.03928?c/12.92:Math.pow((c+.055)/1.055,2.4)).reduce((s,c,i)=>s+[.2126,.7152,.0722][i]*c,0)};const l1=L(h1),l2=L(h2);return(Math.max(l1,l2)+.05)/(Math.min(l1,l2)+.05)}",
 "T14-darken": "(hex) => (l => hl.lab2hex({...l, L: l.L * 0.7}))(hl.hex2lab(hex))",

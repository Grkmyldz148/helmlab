 "T4-physical-mix": "f=(a,b)=>{const l=h=>[...h.matchAll(/[\\da-f]{2}/gi)].map(([x])=>{const s=parseInt(x,16)/255;return s<=0.04045?s/12.92:((s+0.055)/1.055)**2.4});const m=l(a).map((v,i)=>(v+l(b)[i])/2);return'#'+m.map(v=>{const s=v<=0.0031308?v*12.92:1.055*v**(1/2.4)-0.055;return Math.round(s*255).toString(16).padStart(2,'0')}).join('')}",

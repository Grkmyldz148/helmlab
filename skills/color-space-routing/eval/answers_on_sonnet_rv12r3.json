 "T6-lch-distance": "((c1,c2)=>{const d=h=>h*Math.PI/180;const a1=c1[1]*Math.cos(d(c1[2])),b1=c1[1]*Math.sin(d(c1[2])),a2=c2[1]*Math.cos(d(c2[2])),b2=c2[1]*Math.sin(d(c2[2]));return Math.sqrt((c1[0]-c2[0])**2+(a1-a2)**2+(b1-b2)**2)})([0.5,0.1,10],[0.5,0.1,350])",

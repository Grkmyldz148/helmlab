{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "`const f = hex => hl.genFromHex(hex)`",
 "T4-physical-mix": "function f(a,b){const l=c=>c<=0.04045?c/12.92:((c+0.055)/1.055)**2.4,g=c=>c<=0.0031308?c*12.92:1.055*c**(1/2.4)-0.055,p=s=>[parseInt(s.slice(1,3),16)/255,parseInt(s.slice(3,5),16)/255,parseInt(s.slice(5,7),16)/255];return'#'+p(a).map(l).map((v,i)=>(v+p(b).map(l)[i])/2).map(g).map(v=>Math.round(v*255).toString(16).padStart(2,'0')).join('')}",
 "T5-hue-wrap": "function f(h1,h2,t){let d=((h2-h1)%360+540)%360-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "Math.hypot(0.1*Math.cos(10*Math.PI/180)-0.1*Math.cos(350*Math.PI/180), 0.1*Math.sin(10*Math.PI/180)-0.1*Math.sin(350*Math.PI/180))",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the ~2.3 just-noticeable-difference threshold and near-achromatic pairs are in the highest human noise band; the difference is not reliably perceivable.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklch`",
 "T13-wcag": "const f=(fg,bg)=>{const l=h=>{const[r,g,b]=[0,2,4].map(i=>parseInt(h.slice(1+i,3+i),16)/255).map(c=>c<=.04045?c/12.92:((c+.055)/1.055)**2.4);return .2126*r+.7152*g+.0722*b};const[L1,L2]=[l(fg),l(bg)].sort((a,b)=>b-a);return(L1+.05)/(L2+.05)};",
 "T14-darken": "f = hex => { const lch = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, lch[0] - 15), lch[1], lch[2]])); }",
 "T15-lightness-sort": "(hexArray) => [...hexArray].sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])",
 "T16-circular-mean": "(a1, a2) => (Math.atan2((Math.sin(a1*Math.PI/180)+Math.sin(a2*Math.PI/180))/2,(Math.cos(a1*Math.PI/180)+Math.cos(a2*Math.PI/180))/2)*180/Math.PI+360)%360",
 "T17-equal-gray": "hl.genToHex([hl.genFromHex('#3b82f6')[0], 0, 0])",
 "T18-angular-dist": "(h1, h2) => { const d = Math.abs(h1 - h2) % 360; return d > 180 ? 360 - d : d; }",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; blue and yellow at the same V differ wildly in perceived brightness, making it unreliable for contrast."

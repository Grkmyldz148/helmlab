{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "const f = hex => hl.genFromHex(hex)",
 "T4-physical-mix": "f=(a,b)=>{const l=h=>[parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)].map(c=>{c/=255;return c<=0.04045?c/12.92:((c+0.055)/1.055)**2.4});const g=c=>c<=0.0031308?12.92*c:1.055*c**(1/2.4)-0.055;return'#'+l(a).map((c,i)=>Math.round(g((c+l(b)[i])/2)*255).toString(16).padStart(2,'0')).join('')}",
 "T5-hue-wrap": "f=(h1,h2,t)=>((h1+(((h2-h1%360+540)%360-180)*t)%360)+360)%360",
 "T6-lch-distance": "(([L1,C1,h1],[L2,C2,h2])=>{const r=Math.PI/180,a1=C1*Math.cos(h1*r),b1=C1*Math.sin(h1*r),a2=C2*Math.cos(h2*r),b2=C2*Math.sin(h2*r);return Math.sqrt((L1-L2)**2+(a1-a2)**2+(b1-b2)**2)})([0.5,0.1,10],[0.5,0.1,350])",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 1.0 is below the ~2.3 JND threshold and within the human noise band for near-threshold, low-chroma pairs.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "const f=(fg,bg)=>{const l=h=>{const[r,g,b]=[h.slice(1,3),h.slice(3,5),h.slice(5,7)].map(x=>parseInt(x,16)/255).map(c=>c<=.04045?c/12.92:((c+.055)/1.055)**2.4);return .2126*r+.7152*g+.0722*b};const[L1,L2]=[l(fg),l(bg)].sort((a,b)=>b-a);return(L1+.05)/(L2+.05)};",
 "T14-darken": "`const f = hex => { const lch = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, lch[0] - 0.15), lch[1], lch[2]])); };`",
 "T15-lightness-sort": "(hexArray) => hexArray.slice().sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])",
 "T16-circular-mean": "(Math.atan2((Math.sin(350*Math.PI/180)+Math.sin(10*Math.PI/180))/2,(Math.cos(350*Math.PI/180)+Math.cos(10*Math.PI/180))/2)*180/Math.PI+360)%360",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(a, b) => { const d = ((b - a) % 360 + 360) % 360; return d > 180 ? 360 - d : d; }",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; yellow and blue at the same V differ wildly in perceived brightness, so it gives wrong contrast ratios."

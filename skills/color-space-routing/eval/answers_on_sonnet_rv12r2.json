{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "const f = hex => hl.genFromHex(hex);",
 "T4-physical-mix": "f=(a,b)=>{const s=c=>parseInt(c,16)/255,l=v=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4,g=v=>v<=.0031308?12.92*v:1.055*v**(1/2.4)-0.055,h=v=>Math.round(v*255).toString(16).padStart(2,'0'),r=(x,y)=>g((l(s(x))+l(s(y)))/2);return'#'+[1,3,5].map(i=>[a.slice(i,i+2),b.slice(i,i+2)]).map(([x,y])=>h(r(x,y))).join('')}",
 "T5-hue-wrap": "function f(h1,h2,t){let d=((h2-h1)%360+540)%360-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "((L1,C1,h1,L2,C2,h2)=>Math.hypot(L2-L1,C2*Math.cos(h2*Math.PI/180)-C1*Math.cos(h1*Math.PI/180),C2*Math.sin(h2*Math.PI/180)-C1*Math.sin(h1*Math.PI/180)))(0.5,0.1,10,0.5,0.1,350)",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is near the perceptibility threshold where human judgments are unreliable; this difference is below the noise band.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "function f(hexFg,hexBg){const l=h=>{const[r,g,b]=[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)/255).map(v=>v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4);return 0.2126*r+0.7152*g+0.0722*b};const[L1,L2]=[l(hexFg),l(hexBg)].sort((a,b)=>b-a);return(L1+0.05)/(L2+0.05)}",
 "T14-darken": "f = hex => { const [L,C,h] = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, L - 0.15), C, h])); }",
 "T15-lightness-sort": "(hexArray) => hexArray.slice().sort((a, b) => hl.genToLch(hl.genFromHex(a))[0] - hl.genToLch(hl.genFromHex(b))[0])",
 "T16-circular-mean": "(h1, h2) => { const r = Math.atan2(Math.sin(h1*Math.PI/180)+Math.sin(h2*Math.PI/180), Math.cos(h1*Math.PI/180)+Math.cos(h2*Math.PI/180))*180/Math.PI; return r < 0 ? r + 360 : r; }",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(a => Math.min(a, 360 - a))(Math.abs(20 - 340))",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; same V, wildly different perceived brightness (e.g. yellow vs blue)."

{
 "T1-blue-gradient": "`Array.from({length:16},(_,i)=>hl.genToHex(hl.genFromHex('#0000ff').map((v,j)=>v+(hl.genFromHex('#ffffff')[j]-v)*i/15)))`",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "`const f = hex => hl.genFromHex(hex)`",
 "T4-physical-mix": "const f=(a,b)=>{const p=(h,i)=>parseInt(h.slice(1+i*2,3+i*2),16);const L=v=>(v/=255,v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4);const G=v=>v<=0.0031308?12.92*v:1.055*v**(1/2.4)-0.055;return'#'+'rgb'.split('').map((_,i)=>Math.round(G((L(p(a,i))+L(p(b,i)))/2)*255).toString(16).padStart(2,'0')).join('')};",
 "T5-hue-wrap": "function f(h1,h2,t){const d=((h2-h1+540)%360)-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "((c1,c2)=>Math.sqrt((c1[0]-c2[0])**2+(c1[1]*Math.cos(c1[2]*Math.PI/180)-c2[1]*Math.cos(c2[2]*Math.PI/180))**2+(c1[1]*Math.sin(c1[2]*Math.PI/180)-c2[1]*Math.sin(c2[2]*Math.PI/180))**2))([0.5,0.1,10],[0.5,0.1,350])",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the ~2.3 just-noticeable-difference threshold, so the difference is imperceptible.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "function f(h,b){const c=s=>({r:parseInt(s.slice(1,3),16)/255,g:parseInt(s.slice(3,5),16)/255,b:parseInt(s.slice(5,7),16)/255});const l=({r,g,b})=>{const[R,G,B]=[r,g,b].map(v=>v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4);return 0.2126*R+0.7152*G+0.0722*B};const[L1,L2]=[l(c(h)),l(c(b))].sort((a,b)=>b-a);return(L1+0.05)/(L2+0.05)}",
 "T14-darken": "const f = hex => { const {L,C,h} = hl.genToLch(hex); return hl.genFromLch({L: Math.max(0, L - 20), C, h}); }",
 "T15-lightness-sort": "`f = hexArray => hexArray.slice().sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])`",
 "T16-circular-mean": "(a, b) => ((Math.atan2((Math.sin(a * Math.PI / 180) + Math.sin(b * Math.PI / 180)) / 2, (Math.cos(a * Math.PI / 180) + Math.cos(b * Math.PI / 180)) / 2) * 180 / Math.PI) + 360) % 360",
 "T17-equal-gray": "hl.genToHex({...hl.genFromHex('#3b82f6'), a: 0, b: 0})",
 "T18-angular-dist": "(((340 - 20) % 360 + 540) % 360) - 180",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; yellow and blue at the same V look wildly different in brightness."
}
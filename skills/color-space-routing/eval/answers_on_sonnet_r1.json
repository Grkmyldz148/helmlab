{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "const f = hex => hl.genFromHex(hex);",
 "T4-physical-mix": "function f(hexA,hexB){const p=h=>[parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255].map(c=>c<=0.04045?c/12.92:((c+0.055)/1.055)**2.4);const e=c=>c<=0.0031308?c*12.92:1.055*c**(1/2.4)-0.055;const[a,b]=[p(hexA),p(hexB)];return'#'+a.map((v,i)=>Math.round(e((v+b[i])/2)*255).toString(16).padStart(2,'0')).join('');}",
 "T5-hue-wrap": "function f(h1,h2,t){let d=((h2-h1)%360+540)%360-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "((c1,c2)=>{const r=Math.PI/180;const a1=c1[1]*Math.cos(c1[2]*r),b1=c1[1]*Math.sin(c1[2]*r),a2=c2[1]*Math.cos(c2[2]*r),b2=c2[1]*Math.sin(c2[2]*r);return Math.sqrt((c1[0]-c2[0])**2+(a1-a2)**2+(b1-b2)**2)})([0.5,0.1,10],[0.5,0.1,350])",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is near the ~2.3 just-noticeable threshold; at low chroma where human agreement is lowest, this difference is below the reliable noise band.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklch`",
 "T13-wcag": "function f(fg,bg){const l=h=>{const[r,g,b]=[0,2,4].map(i=>parseInt(h.slice(1+i,3+i),16)/255).map(c=>c<=0.04045?c/12.92:((c+0.055)/1.055)**2.4);return 0.2126*r+0.7152*g+0.0722*b};const[a,b]=[l(fg),l(bg)].sort((x,y)=>y-x);return(a+0.05)/(b+0.05)}",
 "T14-darken": "f = hex => { const [L,C,h] = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, L - 15), C, h])); }",
 "T15-lightness-sort": "f = hexArray => [...hexArray].sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])",
 "T16-circular-mean": "(Math.atan2((Math.sin(350*Math.PI/180)+Math.sin(10*Math.PI/180))/2,(Math.cos(350*Math.PI/180)+Math.cos(10*Math.PI/180))/2)*180/Math.PI+360)%360",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(((340 - 20) % 360 + 360) % 360 > 180 ? 360 - (((340 - 20) % 360 + 360) % 360) : ((340 - 20) % 360 + 360) % 360)",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; yellow and blue at the same V differ wildly in perceived brightness, so contrast predictions are wrong."

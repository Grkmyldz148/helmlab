{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "`(hex) => hl.genFromHex(hex)`",
 "T4-physical-mix": "function f(hexA,hexB){const p=h=>[parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255];const l=c=>c<=0.04045?c/12.92:Math.pow((c+0.055)/1.055,2.4);const g=c=>c<=0.0031308?12.92*c:1.055*Math.pow(c,1/2.4)-0.055;const t=n=>Math.round(n*255).toString(16).padStart(2,'0');const[rA,gA,bA]=p(hexA).map(l);const[rB,gB,bB]=p(hexB).map(l);return'#'+[[rA,rB],[gA,gB],[bA,bB]].map(([a,b])=>t(g((a+b)/2))).join('');}",
 "T5-hue-wrap": "function f(h1,h2,t){let d=((h2-h1)%360+540)%360-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "((L1,C1,h1,L2,C2,h2)=>Math.hypot(L2-L1,C2*Math.cos(h2*Math.PI/180)-C1*Math.cos(h1*Math.PI/180),C2*Math.sin(h2*Math.PI/180)-C1*Math.sin(h1*Math.PI/180)))(0.5,0.1,10,0.5,0.1,350)",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the ~2.3 noticeable threshold; most observers won't see a difference.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "const f=(fg,bg)=>{const l=h=>{const[r,g,b]=[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)/255).map(v=>v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4);return 0.2126*r+0.7152*g+0.0722*b};const[L1,L2]=[l(fg),l(bg)].sort((a,b)=>b-a);return(L1+0.05)/(L2+0.05)};",
 "T14-darken": "f = hex => { const lch = hl.genToLch(hl.genFromHex(hex)); return hl.genToHex(hl.genFromLch([Math.max(0, lch[0] - 0.15), lch[1], lch[2]])); }",
 "T15-lightness-sort": "`f = hexArray => [...hexArray].sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])`",
 "T16-circular-mean": "(Math.atan2((Math.sin(350*Math.PI/180)+Math.sin(10*Math.PI/180))/2,(Math.cos(350*Math.PI/180)+Math.cos(10*Math.PI/180))/2)*180/Math.PI+360)%360",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(((340 - 20) % 360 + 540) % 360) - 180",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; blue and yellow at the same V differ wildly in perceived brightness, making it unreliable for contrast."
}
{
 "T1-blue-gradient": "hl.gradient('#0000ff', '#ffffff', 16)",
 "T2-delta-e": "(hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "const f = (hex) => hl.genFromHex(hex);",
 "T4-physical-mix": "(a,b)=>{const γ=v=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4,γ_=v=>v<=.0031308?12.92*v:1.055*v**(1/2.4)-.055,p=h=>[parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255].map(γ),[x,y]=[[...p(a)],[...p(b)]],m=[0,1,2].map(i=>(x[i]+y[i])/2).map(γ_);return'#'+m.map(v=>Math.round(v*255).toString(16).padStart(2,'0')).join('')}",
 "T5-hue-wrap": "(h1, h2, t) => ((h1 + t * ((d => d > 180 ? d - 360 : d < -180 ? d + 360 : d)(h2 - h1)) + 360) % 360)",
 "T6-lch-distance": "([L1,C1,h1], [L2,C2,h2]) => Math.sqrt((L2-L1)**2 + (C2*Math.cos(h2*Math.PI/180) - C1*Math.cos(h1*Math.PI/180))**2 + (C2*Math.sin(h2*Math.PI/180) - C1*Math.sin(h1*Math.PI/180))**2)",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the perceptual threshold (~2.3 rule of thumb) and ΔE metrics are unreliable for low-chroma colors anyway.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "(fg,bg)=>{const l=h=>{const[r,g,b]=h.slice(1).match(/../g).map(x=>parseInt(x,16)/255),[R,G,B]=[r,g,b].map(c=>c<=0.03928?c/12.92:Math.pow((c+0.055)/1.055,2.4));return 0.2126*R+0.7152*G+0.0722*B};const x=Math.max(l(fg),l(bg)),y=Math.min(l(fg),l(bg));return(x+0.05)/(y+0.05)}",
 "T14-darken": "const f=hex=>{const[L,C,h]=hl.genToLch(hl.genFromHex(hex));return hl.genToHex(hl.genFromLch([Math.max(0,L-0.15),C,h]))};",
 "T15-lightness-sort": "hexArray => hexArray.sort((a, b) => hl.genToLch(hl.genFromHex(a))[0] - hl.genToLch(hl.genFromHex(b))[0])",
 "T16-circular-mean": "(a, b) => ((Math.atan2(Math.sin(a*Math.PI/180) + Math.sin(b*Math.PI/180), Math.cos(a*Math.PI/180) + Math.cos(b*Math.PI/180)) * 180 / Math.PI) + 360) % 360",
 "T17-equal-gray": "hl.genToHex(hl.genFromLch([hl.genToLch(hl.genFromHex('#3b82f6'))[0], 0, 0]))",
 "T18-angular-dist": "(h1, h2) => Math.min(Math.abs(h2 - h1), 360 - Math.abs(h2 - h1))",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptually uniform; yellow and blue at the same V differ wildly in perceived lightness, invalidating accessibility contrast checks."

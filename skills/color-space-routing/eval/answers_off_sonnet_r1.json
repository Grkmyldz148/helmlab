 "T10-noticeable": "No — ΔE00 = 1.0 is at the threshold of just-noticeable difference; low-chroma grays at that level are perceptually borderline, not a clear regression.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklch`",
 "T13-wcag": "function f(h,b){const c=s=>({r:parseInt(s.slice(1,3),16)/255,g:parseInt(s.slice(3,5),16)/255,b:parseInt(s.slice(5,7),16)/255});const l=({r,g,b})=>[r,g,b].reduce((a,v)=>{v=v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4;return a+v*[0.2126,0.7152,0.0722].shift()},0);const L1=l(c(h)),L2=l(c(b));return(Math.max(L1,L2)+0.05)/(Math.min(L1,L2)+0.05);}",
 "T14-darken": "f = hex => { const [l,c,h] = hl.hexToLCH(hex); return hl.LCHToHex(l * 0.65, c, h); }",
 "T15-lightness-sort": "f = hexArray => [...hexArray].sort((a, b) => hl(a) - hl(b))",
 "T16-circular-mean": "(angles => { const toRad = d => d * Math.PI / 180; const meanSin = angles.reduce((s, a) => s + Math.sin(toRad(a)), 0) / angles.length; const meanCos = angles.reduce((s, a) => s + Math.cos(toRad(a)), 0) / angles.length; return (Math.atan2(meanSin, meanCos) * 180 / Math.PI + 360) % 360; })([350, 10])",
 "T17-equal-gray": "(()=>{const t=hl('#3b82f6');let lo=0,hi=255;while(lo<hi){const m=lo+hi>>1;hl('#'+m.toString(16).padStart(2,'0').repeat(3))<t?lo=m+1:hi=m}const h=lo.toString(16).padStart(2,'0');return'#'+h+h+h})()",
 "T18-angular-dist": "(a, b) => Math.min(Math.abs(a - b), 360 - Math.abs(a - b))",
 "T19-cat": "Chromatic adaptation",

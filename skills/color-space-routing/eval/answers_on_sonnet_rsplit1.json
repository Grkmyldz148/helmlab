{
 "T1-blue-gradient": "Array.from({length:16},(_,i)=>{const t=i/15,s=hl.genFromHex('#0000ff'),e=hl.genFromHex('#ffffff');return hl.genToHex(s.map((v,j)=>v+(e[j]-v)*t))})",
 "T2-delta-e": "const f = (hex1, hex2) => hl.difference(hex1, hex2)",
 "T3-gray-axis": "const f = hex => hl.genFromHex(hex)",
 "T4-physical-mix": "f=(a,b)=>{const l=c=>c<=.04045?c/12.92:((c+.055)/1.055)**2.4,g=c=>c<=.0031308?12.92*c:1.055*c**(1/2.4)-.055,p=s=>[1,3,5].map(i=>parseInt(s.slice(i,i+2),16)/255),r=p(a),q=p(b);return'#'+[0,1,2].map(i=>Math.round(g((l(r[i])+l(q[i]))/2)*255).toString(16).padStart(2,'0')).join('')}",
 "T5-hue-wrap": "function f(h1,h2,t){const d=((h2-h1+540)%360)-180;return((h1+d*t)%360+360)%360;}",
 "T6-lch-distance": "Math.sqrt((0.1*Math.cos(10*Math.PI/180)-0.1*Math.cos(350*Math.PI/180))**2+(0.1*Math.sin(10*Math.PI/180)-0.1*Math.sin(350*Math.PI/180))**2+(0.5-0.5)**2)",
 "T7-cvd": "OKLab",
 "T8-picker": "okhsl",
 "T9-hdr": "Jzazbz",
 "T10-noticeable": "No — ΔE00 = 1.0 is below the ~2.3 just-noticeable-difference threshold, so the difference is imperceptible to humans.",
 "T11-css-nearby": "`oklch`",
 "T12-css-distant": "`oklab`",
 "T13-wcag": "function f(h,b){const r=s=>parseInt(s.slice(1,3),16)/255,g=s=>parseInt(s.slice(3,5),16)/255,bl=s=>parseInt(s.slice(5,7),16)/255,lin=c=>c<=.03928?c/12.92:((c+.055)/1.055)**2.4,lum=s=>.2126*lin(r(s))+.7152*lin(g(s))+.0722*lin(bl(s)),L1=lum(h),L2=lum(b);return(Math.max(L1,L2)+.05)/(Math.min(L1,L2)+.05)}",
 "T14-darken": "f = hex => { const [l,c,h] = hl.genToLch(hex); return hl.genFromLch([Math.max(0, l - 0.15), c, h]); }",
 "T15-lightness-sort": "(hexArray) => [...hexArray].sort((a, b) => hl.genFromHex(a)[0] - hl.genFromHex(b)[0])",
 "T16-circular-mean": "(h1, h2) => { const r = Math.PI / 180; return (Math.atan2((Math.sin(h1 * r) + Math.sin(h2 * r)) / 2, (Math.cos(h1 * r) + Math.cos(h2 * r)) / 2) / r + 360) % 360; }",
 "T17-equal-gray": "`hl.genToHex(Object.assign(hl.genFromHex('#3b82f6'),{a:0,b:0}))`",
 "T18-angular-dist": "(a, b) => { const d = ((b - a) % 360 + 360) % 360; return d > 180 ? 360 - d : d; }",
 "T19-cat": "Chromatic adaptation",
 "T20-hsv-contrast": "No — HSV Value is not perceptual lightness; yellow and blue at the same V differ dramatically in perceived brightness, making it useless for WCAG contrast checks."
}